---
/**
 * SubnetLab.astro
 *
 * Accessible, interactive IPv4 subnet learning lab for NEC 5.3, CE 1.3 CO 7.
 * Features:
 * - Strict dotted-quad and prefix validation
 * - Preserves invalid input readable with last-valid-output warning (no NaN)
 * - 32-bit visual strip with network/host bit distinction & accessible text alternative
 * - Step-by-step bitwise AND breakdown for each octet
 * - Subnet boundary, wildcard, and block size calculation
 * - RFC 3021 /31 point-to-point and /32 single-host semantics
 * - /0 generic arithmetic vs routing context documentation
 * - Equal-size subnet splitting with small bounded table (no millions rows)
 * - Full static SSR fallback: complete calculation rendered server-side
 */
import {
  calculateSubnet,
  splitSubnet,
  WORKED_EXAMPLES,
  type SubnetCalculation,
  type SubnetSplitResult,
} from '../../lib/subnet-math.ts';

// Initial server-side rendered state (Lok Sewa model problem)
const initialIp = '200.168.10.75';
const initialPrefix = 24;
const initialBorrow = 3;

let initialCalc: SubnetCalculation;
let initialSplit: SubnetSplitResult;

try {
  initialCalc = calculateSubnet(initialIp, initialPrefix);
  initialSplit = splitSubnet(initialIp, initialPrefix, initialBorrow, 16);
} catch (e) {
  // Fallback defaults if math fails
  initialCalc = calculateSubnet('192.168.1.1', 24);
  initialSplit = splitSubnet('192.168.1.1', 24, 2, 16);
}
---

<subnet-lab class="subnet-lab not-content" data-initial-ip={initialIp} data-initial-prefix={initialPrefix} data-initial-borrow={initialBorrow}>
  <section class="lab-card" aria-labelledby="subnet-lab-heading">
    <div class="lab-header">
      <div class="lab-title-group">
        <span class="lab-badge">NEC 5.3 · CE 1.3 CO 7 Interactive Workbench</span>
        <h2 id="subnet-lab-heading" class="lab-heading">IPv4 Subnet Calculation & Analysis Engine</h2>
      </div>
      <p class="lab-desc">
        Explore 32-bit address architecture, bitwise AND masking, RFC 3021 point-to-point links, host ranges, and equal-size subnet splitting in real time.
      </p>
    </div>

    <!-- Presets Toolbar -->
    <div class="preset-bar">
      <label for="preset-select" class="preset-label">
        <span>Load Worked Preset:</span>
      </label>
      <select id="preset-select" class="lab-select" data-preset-select aria-label="Select worked example preset">
        <option value="">-- Choose a standard exam or RFC scenario --</option>
        {WORKED_EXAMPLES.map((ex) => (
          <option value={ex.id} data-ip={ex.inputIp} data-prefix={ex.inputPrefix} data-borrow={ex.borrowedBits ?? 2}>
            {ex.title}
          </option>
        ))}
      </select>
    </div>

    <!-- Input Controls -->
    <div class="controls-grid">
      <div class="control-group">
        <label for="ip-input" class="control-label">
          <span>IPv4 Host Address</span>
          <span class="control-sublabel">(Strict dotted-decimal: 0.0.0.0 – 255.255.255.255)</span>
        </label>
        <input
          id="ip-input"
          type="text"
          class="lab-input"
          data-ip-input
          value={initialIp}
          spellcheck="false"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby="ip-feedback-status"
        />
      </div>

      <div class="control-group">
        <div class="control-label-row">
          <label for="prefix-slider" class="control-label">
            <span>Subnet Prefix Length</span>
          </label>
          <span class="prefix-display">/<output data-prefix-badge id="prefix-output">{initialPrefix}</output></span>
        </div>
        <div class="slider-with-number">
          <input
            id="prefix-slider"
            type="range"
            min="0"
            max="32"
            value={initialPrefix}
            class="lab-slider"
            data-prefix-slider
            aria-label="Prefix length slider from 0 to 32"
          />
          <input
            id="prefix-number"
            type="number"
            min="0"
            max="32"
            value={initialPrefix}
            class="lab-number-input"
            data-prefix-input
            aria-label="Prefix length numeric input"
          />
        </div>
      </div>

      <div class="control-group">
        <div class="control-label-row">
          <label for="borrow-slider" class="control-label">
            <span>Split: Borrow Host Bits</span>
          </label>
          <span class="borrow-display"><output data-borrow-badge id="borrow-output">{initialBorrow}</output> bits</span>
        </div>
        <div class="slider-with-number">
          <input
            id="borrow-slider"
            type="range"
            min="1"
            max="8"
            value={initialBorrow}
            class="lab-slider"
            data-borrow-slider
            aria-label="Borrowed bits slider for subnet splitting"
          />
          <input
            id="borrow-number"
            type="number"
            min="1"
            max="8"
            value={initialBorrow}
            class="lab-number-input"
            data-borrow-input
            aria-label="Borrowed bits numeric input"
          />
        </div>
      </div>
    </div>

    <!-- Error & Warning Status Banners -->
    <div id="ip-feedback-status" class="feedback-area" aria-live="polite">
      <div class="alert-banner error-banner" data-error-banner hidden role="alert">
        <span class="alert-icon" aria-hidden="true">⚠️</span>
        <div class="alert-content">
          <strong class="alert-title">Input Error:</strong>
          <span data-error-text></span>
        </div>
      </div>
      <div class="alert-banner warning-banner" data-warning-banner hidden role="status">
        <span class="alert-icon" aria-hidden="true">ℹ️</span>
        <div class="alert-content">
          <strong class="alert-title">Preserving Last Valid State:</strong>
          <span data-warning-text>Showing results for last valid input. Correct the address above to recalculate.</span>
        </div>
      </div>
    </div>

    <!-- RFC / Special Context Note -->
    <div class="context-banner" data-context-banner hidden={!initialCalc.contextNote}>
      <span class="context-icon" aria-hidden="true">💡</span>
      <p class="context-text" data-context-text>{initialCalc.contextNote ?? ''}</p>
    </div>

    <!-- 32-Bit Visual Strip -->
    <div class="strip-section">
      <div class="section-title-row">
        <h3 class="section-subtitle">32-Bit Binary Structure (Address · Mask · Network)</h3>
        <span class="strip-legend">
          <span class="legend-chip legend-net">Network bits</span>
          <span class="legend-chip legend-host">Host bits</span>
        </span>
      </div>

      <!-- Screen reader text alternative -->
      <p class="sr-only" data-strip-accessible-text>{initialCalc.stripAccessibleText}</p>

      <div class="strip-container" data-strip-container aria-hidden="true">
        <!-- Address Row -->
        <div class="strip-row">
          <span class="strip-label">IP Address:</span>
          <div class="bits-flow" data-strip-ip>
            {initialCalc.stripBits.map((b, idx) => (
              <>
                <span class={`bit ${b.isNetwork ? 'bit-net' : 'bit-host'}`}>{b.ipBit}</span>
                {(idx + 1) % 8 === 0 && idx < 31 ? <span class="bit-sep">.</span> : null}
              </>
            ))}
          </div>
        </div>

        <!-- Mask Row -->
        <div class="strip-row">
          <span class="strip-label">Subnet Mask:</span>
          <div class="bits-flow" data-strip-mask>
            {initialCalc.stripBits.map((b, idx) => (
              <>
                <span class={`bit ${b.isNetwork ? 'bit-net' : 'bit-host'}`}>{b.maskBit}</span>
                {(idx + 1) % 8 === 0 && idx < 31 ? <span class="bit-sep">.</span> : null}
              </>
            ))}
          </div>
        </div>

        <!-- Network Row -->
        <div class="strip-row">
          <span class="strip-label">Network ID:</span>
          <div class="bits-flow" data-strip-net>
            {initialCalc.stripBits.map((b, idx) => (
              <>
                <span class={`bit ${b.isNetwork ? 'bit-net' : 'bit-host'}`}>{b.networkBit}</span>
                {(idx + 1) % 8 === 0 && idx < 31 ? <span class="bit-sep">.</span> : null}
              </>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Subnet Facts Grid -->
    <div class="facts-section">
      <h3 class="section-subtitle">Subnet Numerical Properties</h3>
      <dl class="facts-grid" data-facts-grid>
        <div class="fact-card">
          <dt>Subnet Mask</dt>
          <dd data-fact-mask>{initialCalc.maskStr} (/{initialCalc.prefix})</dd>
        </div>
        <div class="fact-card">
          <dt>Network Address</dt>
          <dd data-fact-network>{initialCalc.networkStr}/{initialCalc.prefix}</dd>
        </div>
        <div class="fact-card">
          <dt>Directed Broadcast</dt>
          <dd data-fact-broadcast>{initialCalc.broadcastStr}</dd>
        </div>
        <div class="fact-card">
          <dt>Usable Host Range</dt>
          <dd data-fact-range>{initialCalc.hostRangeStr}</dd>
        </div>
        <div class="fact-card">
          <dt>Usable Hosts Count</dt>
          <dd data-fact-usable-hosts>{initialCalc.usableHosts.toLocaleString()}</dd>
        </div>
        <div class="fact-card">
          <dt>Total Addresses (2<sup>32-p</sup>)</dt>
          <dd data-fact-total-addrs>{initialCalc.totalAddresses.toLocaleString()}</dd>
        </div>
        <div class="fact-card">
          <dt>Wildcard (Inverse Mask)</dt>
          <dd data-fact-wildcard>{initialCalc.wildcardStr}</dd>
        </div>
        <div class="fact-card">
          <dt>Interesting Octet & Block Size</dt>
          <dd data-fact-block>Octet {initialCalc.interestingOctet} (step: {initialCalc.blockSize})</dd>
        </div>
        <div class="fact-card">
          <dt>Historical Class & Scope</dt>
          <dd data-fact-class>{initialCalc.addressClass} · {initialCalc.scope}{initialCalc.scope === 'unclassified' ? ' (not a routability check)' : ''}</dd>
        </div>
      </dl>
    </div>

    <!-- Step-by-Step Bitwise AND Table -->
    <div class="and-section">
      <h3 class="section-subtitle">Step-by-Step Bitwise AND Derivation (IP AND Mask = Network)</h3>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Step-by-Step Bitwise AND Table">
        <table class="lab-table and-table" data-and-table>
          <thead>
            <tr>
              <th scope="col">Octet</th>
              <th scope="col">IP Address</th>
              <th scope="col" aria-label="Bitwise Operator">&nbsp;</th>
              <th scope="col">Subnet Mask</th>
              <th scope="col" aria-label="Equals">&nbsp;</th>
              <th scope="col">Network Result</th>
              <th scope="col">Binary Calculation</th>
            </tr>
          </thead>
          <tbody data-and-tbody>
            {initialCalc.andSteps.map((step) => (
              <tr>
                <td>Octet {step.octetIndex}</td>
                <td><code>{step.ipDecimal}</code></td>
                <td>AND</td>
                <td><code>{step.maskDecimal}</code></td>
                <td>=</td>
                <td><strong><code>{step.networkDecimal}</code></strong></td>
                <td>
                  <span class="mono-calc">{step.ipBinary} &amp; {step.maskBinary} = <strong>{step.networkBinary}</strong></span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Equal-Size Subnet Splitting Table -->
    <div class="split-section">
      <div class="section-title-row">
        <h3 class="section-subtitle" data-split-heading>
          Equal-Size Split: Borrow {initialSplit.borrowedBits} Bit(s) → {initialSplit.totalSubnets} Subnets of /{initialSplit.childPrefix}
        </h3>
        <span class="split-summary-badge" data-split-summary>
          {initialSplit.hostsPerSubnet.toLocaleString()} usable hosts/subnet · Block size {initialSplit.blockSize}
        </span>
      </div>

      <div class="table-scroll" tabindex="0" role="region" aria-label="Equal-Size Subnet Splitting Table">
        <table class="lab-table split-table" data-split-table>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Subnet CIDR</th>
              <th scope="col">Subnet Mask</th>
              <th scope="col">First Usable Host</th>
              <th scope="col">Last Usable Host</th>
              <th scope="col">Broadcast</th>
              <th scope="col">Usable Hosts</th>
            </tr>
          </thead>
          <tbody data-split-tbody>
            {initialSplit.rows.map((row) => (
              <tr class={row.containsInputIp ? 'active-host-subnet' : ''}>
                <td>{row.index}</td>
                <td>
                  <code>{row.cidrStr}</code>
                  {row.containsInputIp ? <span class="host-marker" title="Input IP is inside this subnet">Your Host</span> : null}
                </td>
                <td><code>{row.maskStr}</code></td>
                <td><code>{row.firstUsableStr}</code></td>
                <td><code>{row.lastUsableStr}</code></td>
                <td><code>{row.broadcastStr}</code></td>
                <td>{row.usableHosts.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="table-note" data-split-note>
        {initialSplit.isTruncated
          ? `Displaying first ${initialSplit.displayedSubnets} of ${initialSplit.totalSubnets} subnets to preserve browser performance.`
          : `All ${initialSplit.totalSubnets} child subnets listed above. The highlighted row holds your input IP address.`}
      </p>
    </div>
  </section>
</subnet-lab>

<script>
  import {
    parseIPv4,
    parsePrefix,
    calculateSubnet,
    splitSubnet,
    WORKED_EXAMPLES,
    type SubnetCalculation,
    type SubnetSplitResult,
  } from '../../lib/subnet-math.ts';

  class SubnetLabElement extends HTMLElement {
    private lastValidIp: string = '200.168.10.75';
    private lastValidPrefix: number = 24;
    private lastValidBorrow: number = 3;

    connectedCallback() {
      const $ = <T extends HTMLElement>(sel: string): T => this.querySelector(sel) as T;

      const ipInput = $<HTMLInputElement>('[data-ip-input]');
      const prefixSlider = $<HTMLInputElement>('[data-prefix-slider]');
      const prefixInput = $<HTMLInputElement>('[data-prefix-input]');
      const prefixBadge = $<HTMLOutputElement>('[data-prefix-badge]');
      const borrowSlider = $<HTMLInputElement>('[data-borrow-slider]');
      const borrowInput = $<HTMLInputElement>('[data-borrow-input]');
      const borrowBadge = $<HTMLOutputElement>('[data-borrow-badge]');
      const presetSelect = $<HTMLSelectElement>('[data-preset-select]');

      const errorBanner = $<HTMLElement>('[data-error-banner]');
      const errorText = $<HTMLElement>('[data-error-text]');
      const warningBanner = $<HTMLElement>('[data-warning-banner]');
      const warningText = $<HTMLElement>('[data-warning-text]');
      const contextBanner = $<HTMLElement>('[data-context-banner]');
      const contextText = $<HTMLElement>('[data-context-text]');

      // Facts elements
      const factMask = $<HTMLElement>('[data-fact-mask]');
      const factNet = $<HTMLElement>('[data-fact-network]');
      const factBc = $<HTMLElement>('[data-fact-broadcast]');
      const factRange = $<HTMLElement>('[data-fact-range]');
      const factUsable = $<HTMLElement>('[data-fact-usable-hosts]');
      const factTotal = $<HTMLElement>('[data-fact-total-addrs]');
      const factWildcard = $<HTMLElement>('[data-fact-wildcard]');
      const factBlock = $<HTMLElement>('[data-fact-block]');
      const factClass = $<HTMLElement>('[data-fact-class]');

      // Visual Strip elements
      const stripAlt = $<HTMLElement>('[data-strip-accessible-text]');
      const stripIp = $<HTMLElement>('[data-strip-ip]');
      const stripMask = $<HTMLElement>('[data-strip-mask]');
      const stripNet = $<HTMLElement>('[data-strip-net]');

      // AND & Split elements
      const andTbody = $<HTMLTableSectionElement>('[data-and-tbody]');
      const splitHeading = $<HTMLElement>('[data-split-heading]');
      const splitSummary = $<HTMLElement>('[data-split-summary]');
      const splitTbody = $<HTMLTableSectionElement>('[data-split-tbody]');
      const splitNote = $<HTMLElement>('[data-split-note]');

      // Read initial values from component dataset
      this.lastValidIp = this.dataset.initialIp || '200.168.10.75';
      this.lastValidPrefix = Number(this.dataset.initialPrefix || '24');
      this.lastValidBorrow = Number(this.dataset.initialBorrow || '3');

      const renderCalc = (calc: SubnetCalculation, split: SubnetSplitResult | null) => {
        // Update facts
        factMask.textContent = `${calc.maskStr} (/${calc.prefix})`;
        factNet.textContent = `${calc.networkStr}/${calc.prefix}`;
        factBc.textContent = calc.broadcastStr;
        factRange.textContent = calc.hostRangeStr;
        factUsable.textContent = calc.usableHosts.toLocaleString();
        factTotal.textContent = calc.totalAddresses.toLocaleString();
        factWildcard.textContent = calc.wildcardStr;
        factBlock.textContent = `Octet ${calc.interestingOctet} (step: ${calc.blockSize})`;
        factClass.textContent = `${calc.addressClass} · ${calc.scope}${calc.scope === 'unclassified' ? ' (not a routability check)' : ''}`;

        // Context Banner
        if (calc.contextNote) {
          contextBanner.hidden = false;
          contextText.textContent = calc.contextNote;
        } else {
          contextBanner.hidden = true;
          contextText.textContent = '';
        }

        // Accessible text
        stripAlt.textContent = calc.stripAccessibleText;

        // Strip rows
        const renderBits = (type: 'ip' | 'mask' | 'net') => {
          let html = '';
          calc.stripBits.forEach((b, idx) => {
            const val = type === 'ip' ? b.ipBit : type === 'mask' ? b.maskBit : b.networkBit;
            const cls = b.isNetwork ? 'bit bit-net' : 'bit bit-host';
            html += `<span class="${cls}">${val}</span>`;
            if ((idx + 1) % 8 === 0 && idx < 31) {
              html += '<span class="bit-sep">.</span>';
            }
          });
          return html;
        };

        stripIp.innerHTML = renderBits('ip');
        stripMask.innerHTML = renderBits('mask');
        stripNet.innerHTML = renderBits('net');

        // AND steps table
        let andHtml = '';
        for (const step of calc.andSteps) {
          andHtml += `<tr>
            <td>Octet ${step.octetIndex}</td>
            <td><code>${step.ipDecimal}</code></td>
            <td>AND</td>
            <td><code>${step.maskDecimal}</code></td>
            <td>=</td>
            <td><strong><code>${step.networkDecimal}</code></strong></td>
            <td><span class="mono-calc">${step.ipBinary} &amp; ${step.maskBinary} = <strong>${step.networkBinary}</strong></span></td>
          </tr>`;
        }
        andTbody.innerHTML = andHtml;

        // Subnet split table
        if (split) {
          splitHeading.textContent = `Equal-Size Split: Borrow ${split.borrowedBits} Bit(s) → ${split.totalSubnets} Subnets of /${split.childPrefix}`;
          splitSummary.textContent = `${split.hostsPerSubnet.toLocaleString()} usable hosts/subnet · Block size ${split.blockSize}`;

          let splitHtml = '';
          for (const row of split.rows) {
            const activeCls = row.containsInputIp ? ' class="active-host-subnet"' : '';
            const marker = row.containsInputIp ? ' <span class="host-marker" title="Input IP is inside this subnet">Your Host</span>' : '';
            splitHtml += `<tr${activeCls}>
              <td>${row.index}</td>
              <td><code>${row.cidrStr}</code>${marker}</td>
              <td><code>${row.maskStr}</code></td>
              <td><code>${row.firstUsableStr}</code></td>
              <td><code>${row.lastUsableStr}</code></td>
              <td><code>${row.broadcastStr}</code></td>
              <td>${row.usableHosts.toLocaleString()}</td>
            </tr>`;
          }
          splitTbody.innerHTML = splitHtml;

          splitNote.textContent = split.isTruncated
            ? `Displaying first ${split.displayedSubnets} of ${split.totalSubnets} subnets to preserve browser performance.`
            : `All ${split.totalSubnets} child subnets listed above. The highlighted row holds your input IP address.`;
        } else {
          splitHeading.textContent = 'Equal-Size Split: Not applicable for /32 (Single Host)';
          splitSummary.textContent = 'A /32 prefix contains only 1 address and cannot be further subdivided.';
          splitTbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding: 1.2rem; color: var(--sl-color-gray-3);">Subnet splitting requires at least 1 host bit (prefix /0 to /31).</td></tr>';
          splitNote.textContent = 'Single host route /32 has no host bits available to borrow.';
        }
      };

      const update = () => {
        const rawIp = ipInput.value;
        const prefixVal = Number(prefixInput.value);
        const borrowVal = Number(borrowInput.value);

        const ipRes = parseIPv4(rawIp);
        const prefRes = parsePrefix(prefixVal);
        const prefixValid = /^\d+$/.test(prefixInput.value) && prefRes.ok;
        const borrowValid = prefixVal === 32 || (borrowInput.disabled && borrowVal === 0) || (/^\d+$/.test(borrowInput.value) && Number.isInteger(borrowVal) && borrowVal >= 1);
        const fail = (message: string) => {
          ipInput.setAttribute('aria-invalid', String(!ipRes.ok));
          prefixInput.setAttribute('aria-invalid', String(!prefixValid));
          borrowInput.setAttribute('aria-invalid', String(!borrowValid));
          errorBanner.hidden = false; errorText.textContent = message;
          warningBanner.hidden = false;
          warningText.textContent = `Displaying calculation for last valid input (${this.lastValidIp}/${this.lastValidPrefix}, split borrow ${this.lastValidBorrow} bits). Correct input above to update.`;
        };
        if (!ipRes.ok || !prefixValid || !borrowValid) {
          fail(!ipRes.ok ? ipRes.error : !prefixValid ? 'Enter a whole prefix from 0 to 32.' : 'Borrowed bits must be a positive whole number.');
          return;
        }
        const availableBorrowBits = 32 - prefixVal;
        const maxBorrow = Math.min(8, availableBorrowBits);
        const effectiveBorrow = availableBorrowBits > 0 ? Math.max(1, Math.min(borrowVal, maxBorrow)) : 0;
        try {
          const calc = calculateSubnet(rawIp, prefixVal);
          const split = availableBorrowBits > 0 ? splitSubnet(rawIp, prefixVal, effectiveBorrow, 16) : null;
          renderCalc(calc, split);
          this.lastValidIp = rawIp;
          this.lastValidPrefix = prefixVal;
          this.lastValidBorrow = effectiveBorrow;
          borrowSlider.disabled = borrowInput.disabled = !availableBorrowBits;
          borrowSlider.max = borrowInput.max = String(maxBorrow);
          borrowSlider.value = borrowInput.value = String(effectiveBorrow);
          borrowBadge.textContent = String(effectiveBorrow);
          prefixSlider.value = String(prefixVal); prefixBadge.textContent = String(prefixVal);
          for (const input of [ipInput, prefixInput, borrowInput]) input.setAttribute('aria-invalid', 'false');
          errorBanner.hidden = warningBanner.hidden = true; errorText.textContent = '';
        } catch (e) { fail(e instanceof Error ? e.message : 'Calculation error'); }
      };

      // Event handlers
      ipInput.addEventListener('input', update);

      prefixSlider.addEventListener('input', () => {
        prefixInput.value = prefixSlider.value;
        update();
      });

      prefixInput.addEventListener('input', () => {
        prefixSlider.value = prefixInput.value;
        update();
      });

      borrowSlider.addEventListener('input', () => {
        borrowInput.value = borrowSlider.value;
        update();
      });

      borrowInput.addEventListener('input', () => {
        borrowSlider.value = borrowInput.value;
        update();
      });

      presetSelect.addEventListener('change', () => {
        const selectedId = presetSelect.value;
        if (!selectedId) return;
        const ex = WORKED_EXAMPLES.find((e) => e.id === selectedId);
        if (ex) {
          ipInput.value = ex.inputIp;
          prefixInput.value = String(ex.inputPrefix);
          prefixSlider.value = String(ex.inputPrefix);
          if (ex.borrowedBits) {
            borrowInput.value = String(ex.borrowedBits);
            borrowSlider.value = String(ex.borrowedBits);
          }
          update();
        }
      });

      // Initial validation sync
      update();
    }
  }

  if (typeof customElements !== 'undefined' && !customElements.get('subnet-lab')) {
    customElements.define('subnet-lab', SubnetLabElement);
  }
</script>

<style>
  .subnet-lab {
    display: block;
    margin-block: 2rem;
    font-family: var(--sl-font);
    color: var(--sl-color-gray-1);
    --lab-border: var(--sl-color-gray-5);
  }

  .subnet-lab *, .subnet-lab *::before, .subnet-lab *::after {
