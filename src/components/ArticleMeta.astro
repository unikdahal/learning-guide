---
// Header strip for a written article: where it sits, its level and reading time.
import LevelMeter from './LevelMeter.astro';
import { labUrl, moduleById, partOf, url } from '../lib/site';

interface Props {
  module: string;
  slug: string;
  minutes: number;
  /** The article's lab program, as a path under lab/crates/, e.g. "m01-relational/examples/nulls.rs". */
  lab?: string;
}
const { lab } = Astro.props;
const m = moduleById(Astro.props.module);
const part = partOf(m);
const a = m.articles.find((x) => x.slug === Astro.props.slug);
if (!a) throw new Error(`Article ${Astro.props.slug} not found in module ${m.id}`);
---

<div class="meta not-content" style={`--part: ${part.color}`} data-pagefind-ignore>
  <a href={url(`${m.slug}/`)} class="where">
    <span class="part">Part {part.id}, {part.title}</span>
    <span class="module">Module {m.id}: {m.title}</span>
  </a>
  <div class="facts">
    <LevelMeter level={a.level} />
    <span>Article {a.index} of {m.articles.length}</span>
    <span>{Astro.props.minutes} min read</span>
    {
      lab && (
        <a class="lab" href={labUrl(lab)} title={`lab/crates/${lab}`}>
          <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M5.5 4 1.5 8l4 4M10.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Lab code
        </a>
      )
    }
  </div>
</div>

<style>
  .meta {
    display: grid;
    gap: 0.6rem;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 3px solid var(--part);
    margin-bottom: 2rem;
    font-family: var(--sl-font);
  }
  .where {
    display: grid;
    text-decoration: none;
  }
  .part {
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--qe-part-text);
  }
  .module {
    font-weight: 620;
    color: var(--sl-color-white);
  }
  .where:hover .module {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
  .lab {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 1.75rem;
    padding: 0 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-weight: 600;
    text-decoration: none;
  }
  .lab:hover,
  .lab:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>
