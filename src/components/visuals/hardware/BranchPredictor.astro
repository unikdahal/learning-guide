---
// Part 1: a classic 2-bit saturating-counter predictor guessing the outcome of `if x < t` for a
// stream of values, random or sorted, with a five-stage pipeline that is flushed on every wrong
// guess. Real predictors are far more elaborate, but on random data no predictor can beat
// guessing the more common outcome. Part 2: the measured filter from
// lab/crates/m02-hardware/examples/branches.rs.
const measured = [
  [0, 0.764, 1.286], [5, 1.305, 1.186], [10, 1.732, 1.329], [15, 2.435, 1.341], [20, 2.908, 1.376],
  [25, 3.081, 1.223], [30, 3.945, 1.361], [35, 4.11, 1.195], [40, 4.047, 1.19], [45, 4.503, 1.232],
  [50, 4.665, 1.132], [55, 5.151, 1.135], [60, 4.662, 1.266], [65, 4.362, 1.294], [70, 4.181, 1.11],
  [75, 3.448, 1.375], [80, 3.134, 1.176], [85, 2.4, 1.643], [90, 2.495, 1.282], [95, 1.886, 1.239],
  [100, 1.697, 1.288],
];
---

<qe-branch class="qe-lab qe-br not-content" data-m={JSON.stringify(measured)}>
  <section class="qe-lab-part">
    <p class="qe-lab-h">A predictor guessing <code>if x &lt; t</code></p>
    <div class="pickers">
      <div class="qe-lab-chips prose" role="group" aria-label="Input order">
        <button type="button" data-order="random" aria-pressed="true">Random values</button>
        <button type="button" data-order="sorted" aria-pressed="false">Sorted values</button>
      </div>
      <div class="qe-lab-chips prose" role="group" aria-label="Selectivity">
        <button type="button" data-t="10" aria-pressed="false">10% pass</button>
        <button type="button" data-t="50" aria-pressed="true">50% pass</button>
        <button type="button" data-t="90" aria-pressed="false">90% pass</button>
      </div>
    </div>

    <ol class="stream" data-stream aria-label="Values and predictions"></ol>

    <div class="mid">
      <div>
        <p class="qe-lab-cap">Predictor: a 2-bit counter</p>
        <ol class="states" data-states>
          <li>strongly<br />not taken</li>
          <li>weakly<br />not taken</li>
          <li>weakly<br />taken</li>
          <li>strongly<br />taken</li>
        </ol>
      </div>
      <div>
        <p class="qe-lab-cap">Pipeline</p>
        <ol class="pipe" data-pipe></ol>
      </div>
    </div>

    <dl class="counters" data-counters aria-live="polite"></dl>
    <div class="qe-lab-row controls">
      <button type="button" class="qe-lab-btn" data-step>Next value</button>
      <button type="button" class="qe-lab-btn quiet" data-all>Run all 40</button>
      <button type="button" class="qe-lab-btn quiet" data-reset>Reset</button>
    </div>
    <p class="qe-lab-note" data-note aria-live="polite"></p>
  </section>

  <section class="qe-lab-part">
    <p class="qe-lab-h">Measured: filtering 10M values on the lab VM</p>
    <p class="qe-lab-cap">Median of 7 runs per point. Drag across the chart for values.</p>
    <div data-chart></div>
  </section>
</qe-branch>

<script>
  import { renderLineChart } from '../../../scripts/linechart';

  const LEN = 40;
  const STAGES = ['Fetch', 'Decode', 'Execute', 'Memory', 'Write'];

  function values(order: string): number[] {
    let x = 777;
    const v = Array.from({ length: LEN }, () => {
      x = (x * 1103515245 + 12345) & 0x7fffffff;
      return (x >>> 16) % 100; // high bits: an LCG's low bits are not random
    });
    return order === 'sorted' ? v.sort((a, b) => a - b) : v;
  }

  class QeBranch extends HTMLElement {
    order = 'random';
    t = 50;
    vals: number[] = [];
    at = 0;
    state = 1; // 0..3; >= 2 predicts taken
    log: { taken: boolean; guess: boolean }[] = [];

    connectedCallback() {
      const pick = (sel: string, f: (b: HTMLButtonElement) => void) =>
        this.querySelectorAll<HTMLButtonElement>(sel).forEach((b) =>
          b.addEventListener('click', () => {
            this.querySelectorAll(sel).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            f(b);
            this.reset();
          }),
        );
      pick('[data-order]', (b) => (this.order = b.dataset.order!));
      pick('[data-t]', (b) => (this.t = Number(b.dataset.t)));
      this.querySelector('[data-step]')!.addEventListener('click', () => this.step());
      this.querySelector('[data-all]')!.addEventListener('click', () => {
        while (this.at < LEN) this.step(false);
        this.render();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', () => this.reset());
      this.reset();

      const m: [number, number, number][] = JSON.parse(this.dataset.m!);
      renderLineChart(this.querySelector('[data-chart]')!, {
        series: [
          { name: 'with if', color: 'var(--qe-series-2)', points: m.map((r) => [r[0], r[1]]) },
          { name: 'without branch', color: 'var(--qe-series-1)', points: m.map((r) => [r[0], r[2]]) },
        ],
        xTicks: [0, 25, 50, 75, 100].map((v) => ({ v, label: `${v}%` })),
        yTicks: [0, 1, 2, 3, 4, 5, 6].map((v) => ({ v, label: String(v) })),
        xLabel: 'rows that pass',
        yLabel: 'ns per row',
        fmtX: (x) => `${x}% pass`,
        fmtY: (y) => `${y.toFixed(2)} ns`,
        height: 260,
      });
    }

    reset() {
      this.vals = values(this.order);
      this.at = 0;
      this.state = 1;
      this.log = [];
      this.render();
    }

    step(draw = true) {
      if (this.at >= LEN) return;
      const taken = this.vals[this.at] < this.t;
      const guess = this.state >= 2;
      this.log.push({ taken, guess });
      this.state = taken ? Math.min(3, this.state + 1) : Math.max(0, this.state - 1);
      this.at++;
      if (draw) this.render();
    }

    render() {
      this.querySelector('[data-stream]')!.innerHTML = this.vals
        .map((v, i) => {
          if (i >= this.at) return `<li class="todo"><span>${v}</span></li>`;
          const { taken, guess } = this.log[i];
          return `<li class="${taken ? 'pass' : 'fail'} ${taken === guess ? 'right' : 'wrong'} ${i === this.at - 1 ? 'cur' : ''}"><span>${v}</span><i>${taken === guess ? '✓' : '✗'}</i></li>`;
        })
        .join('');
      this.querySelectorAll('[data-states] li').forEach((li, k) => li.classList.toggle('on', k === this.state));

      const last = this.log[this.at - 1];
      const flushed = last && last.taken !== last.guess;
      this.querySelector('[data-pipe]')!.innerHTML = STAGES.map((s, k) => {
        // Execute (stage 2) holds the branch just resolved; Fetch and Decode hold later rows.
        const row = this.at - 1 + (2 - k);
        const label = row < 0 || row >= LEN ? '·' : `row ${row}`;
        const wrongPath = flushed && k < 2;
        return `<li class="${wrongPath ? 'flush' : ''} ${k === 2 && last ? 'exec' : ''}"><b>${s}</b><span>${wrongPath ? 'flushed' : label}</span></li>`;
      }).join('');

      const misses = this.log.filter((r) => r.taken !== r.guess).length;
      const stats: [string, string][] = [
        ['rows', `${this.at} of ${LEN}`],
        ['wrong guesses', String(misses)],
        ['miss rate', this.at ? `${Math.round((misses / this.at) * 100)}%` : '–'],
      ];
      this.querySelector('[data-counters]')!.innerHTML = stats.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
      (this.querySelector('[data-step]') as HTMLButtonElement).disabled = this.at >= LEN;

      const note = this.querySelector<HTMLElement>('[data-note]')!;
      if (this.at === 0) {
        note.textContent = 'The CPU fetches the instructions after a branch before it knows which way the branch goes, so it must guess. This predictor guesses whatever its counter says, and nudges the counter toward each real outcome.';
      } else if (this.at < LEN) {
        note.textContent = flushed
          ? `Wrong guess on ${this.vals[this.at - 1]}: the instructions fetched down the wrong path are thrown away and the pipeline refills from the right one. In the lab, each wrong guess cost about 7 to 9 ns.`
          : `Right guess on ${this.vals[this.at - 1]}: the instructions already in flight were the right ones, and nothing is lost.`;
      } else if (this.order === 'sorted') {
        note.textContent = `${misses} wrong guess${misses === 1 ? '' : 'es'} in ${LEN}: sorted values pass, pass, pass, then fail, fail, fail, and the counter only has to change its mind at the switch. In the lab, the same 50% filter took 0.96 ns per row on sorted input and about 5 ns on random input.`;
      } else if (this.t === 50) {
        note.textContent = `${misses} wrong guesses in ${LEN}. With random values and half of them passing, the outcome is a coin flip: no predictor can do better than about 50% wrong. That is the peak of the measured curve below.`;
      } else {
        note.textContent = `${misses} wrong guesses in ${LEN}. When ${this.t === 10 ? '90% fail' : '90% pass'}, guessing the common outcome is right most of the time, so the branch is cheap: the measured curve is low at both ends.`;
      }
    }
  }
  if (!customElements.get('qe-branch')) customElements.define('qe-branch', QeBranch);
</script>

<style is:global>
  .qe-br .qe-lab-h code {
    font-size: 0.85em;
  }
  .qe-br .pickers {
    display: grid;
    gap: 0.45rem;
  }
  .qe-br .stream {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 3px;
  }
  .qe-br .stream li {
    margin: 0 !important;
    position: relative;
    display: grid;
    place-items: center;
    min-height: 2.1rem;
    border-radius: 5px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-1);
    font-variant-numeric: tabular-nums;
  }
  .qe-br .stream li.todo {
    color: var(--sl-color-gray-2);
    border-style: dashed;
  }
  .qe-br .stream li.pass {
    background: color-mix(in srgb, var(--qe-series-1) 22%, var(--sl-color-black));
  }
  .qe-br .stream li i {
    position: absolute;
    top: -1px;
    right: 2px;
    font-style: normal;
    font-size: 0.625rem;
    font-weight: 800;
    color: var(--sl-color-gray-3);
  }
  .qe-br .stream li.wrong {
    border-color: var(--qe-series-2);
  }
  .qe-br .stream li.wrong i {
    color: var(--qe-series-2);
  }
  .qe-br .stream li.cur {
    box-shadow: 0 0 0 2px var(--sl-color-white);
  }
  .qe-br .mid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    margin-top: 0.9rem;
  }
  .qe-br .states,
  .qe-br .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
  }
  .qe-br .pipe {
    grid-template-columns: repeat(5, 1fr);
  }
  .qe-br .states li,
  .qe-br .pipe li {
    margin: 0 !important;
    padding: 0.3rem 0.2rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    text-align: center;
    font-size: 0.6875rem;
    line-height: 1.25;
    color: var(--sl-color-gray-3);
    transition: background-color 0.2s, border-color 0.2s;
  }
  .qe-br .states li.on {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 700;
  }
  .qe-br .pipe li b {
    display: block;
    color: var(--sl-color-gray-2);
    font-size: 0.6875rem;
  }
  .qe-br .pipe li span {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
  }
  .qe-br .pipe li.exec {
    border-color: var(--sl-color-accent);
  }
  .qe-br .pipe li.flush {
    border-color: var(--qe-series-2);
    background: color-mix(in srgb, var(--qe-series-2) 18%, var(--sl-color-black));
    color: var(--sl-color-white);
  }
  .qe-br .counters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    margin: 0.8rem 0 0;
  }
  .qe-br .counters div {
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
  }
  .qe-br .counters dt {
    font-size: 0.6875rem;
    color: var(--sl-color-gray-3);
  }
  .qe-br .counters dd {
    margin: 0;
    font-weight: 700;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }
  .qe-br .controls {
    margin-top: 0.9rem;
  }
  @media (min-width: 50rem) {
    .qe-br .mid {
      grid-template-columns: 1fr 1.2fr;
    }
  }
</style>
