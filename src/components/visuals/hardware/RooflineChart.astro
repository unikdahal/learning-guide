---
// The lab VM's measured roofline: two roofs (memory bandwidth from a vectorized copy, in DRAM
// and in L2, rising to the measured AVX-512 FMA peak) and the measured points of the polynomial
// sweep. Toggle to place common query operators by their arithmetic intensity. All numbers from
// lab/crates/m02-hardware/examples/roofline.rs.
const data = {
  peak: 170.9,
  bwDram: 16.34,
  bwL2: 62.19,
  l2: [[0.25, 17.85], [0.5, 33.65], [1, 66.63], [2, 101.32], [4, 83.6], [8, 76.25], [16, 69.36], [32, 56.47]],
  dram: [[0.25, 2.66], [0.5, 4.92], [1, 10.01], [2, 21.73], [4, 42.55], [8, 70.32], [16, 76.73], [32, 53.81]],
  ops: [
    { name: 'sum of f64', i: 0.125, note: '1 add per 8-byte value' },
    { name: 'a * b + c, f64', i: 2 / 24, note: '2 flops per 24 bytes read' },
    { name: 'filter x < t, u32', i: 0.25, note: '1 compare per 4-byte value' },
    { name: 'degree-16 polynomial', i: 4, note: '32 flops per 8 bytes' },
  ],
};
---

<qe-roofline class="qe-lab qe-roof not-content" data-d={JSON.stringify(data)}>
  <section class="qe-lab-part">
    <p class="qe-lab-h">The lab VM’s roofline, one core</p>
    <div class="qe-lab-chips prose" role="group" aria-label="Show">
      <button type="button" data-show="measured" aria-pressed="true">Measured sweep</button>
      <button type="button" data-show="ops" aria-pressed="false">Where query operators sit</button>
    </div>
    <ul class="legend" data-legend></ul>
    <div class="plot" data-plot></div>
    <p class="qe-lab-note" data-note aria-live="polite"></p>
  </section>
</qe-roofline>

<script>
  type D = {
    peak: number;
    bwDram: number;
    bwL2: number;
    l2: [number, number][];
    dram: [number, number][];
    ops: { name: string; i: number; note: string }[];
  };
  const NS = 'http://www.w3.org/2000/svg';
  const X0 = 0.05;
  const X1 = 64;
  const Y0 = 1;
  const Y1 = 300;

  class QeRoofline extends HTMLElement {
    d!: D;
    show = 'measured';

    connectedCallback() {
      this.d = JSON.parse(this.dataset.d!);
      this.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) =>
        b.addEventListener('click', () => {
          this.show = b.dataset.show!;
          this.querySelectorAll('[data-show]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.render();
        }),
      );
      new ResizeObserver(() => this.render()).observe(this.querySelector('[data-plot]')!);
      this.render();
    }

    render() {
      const plot = this.querySelector<HTMLElement>('[data-plot]')!;
      const W = Math.max(280, plot.clientWidth);
      const H = 300;
      const m = { l: 46, r: 12, t: 12, b: 44 };
      const iw = W - m.l - m.r;
      const ih = H - m.t - m.b;
      const sx = (v: number) => m.l + ((Math.log10(v) - Math.log10(X0)) / (Math.log10(X1) - Math.log10(X0))) * iw;
      const sy = (v: number) => m.t + ih - ((Math.log10(v) - Math.log10(Y0)) / (Math.log10(Y1) - Math.log10(Y0))) * ih;
      const parts: string[] = [];
      for (const y of [1, 3, 10, 30, 100, 300]) {
        parts.push(`<line class="grid" x1="${m.l}" x2="${W - m.r}" y1="${sy(y)}" y2="${sy(y)}"/><text class="tick" x="${m.l - 6}" y="${sy(y) + 4}" text-anchor="end">${y}</text>`);
      }
      for (const x of [0.0625, 0.25, 1, 4, 16, 64]) {
        const anchor = x === X1 ? 'end' : 'middle';
        parts.push(`<text class="tick" x="${anchor === 'end' ? W - m.r : sx(x)}" y="${H - m.b + 16}" text-anchor="${anchor}">${x < 1 ? `1/${1 / x}` : x}</text>`);
      }
      parts.push(`<text class="label" x="${m.l + iw / 2}" y="${H - 6}" text-anchor="middle">flops per byte moved</text>`);
      parts.push(`<text class="label" x="12" y="${m.t + ih / 2}" transform="rotate(-90 12 ${m.t + ih / 2})" text-anchor="middle">GFLOP/s</text>`);
      const roof = (bw: number, cls: string, label: string, lx: number) => {
        const ridge = this.d.peak / bw;
        const xs = X0;
        const pts = `${sx(xs)},${sy(Math.max(bw * xs, Y0))} ${sx(ridge)},${sy(this.d.peak)} ${sx(X1)},${sy(this.d.peak)}`;
        parts.push(`<polyline class="roof ${cls}" points="${pts}"/>`);
        const ly = bw * lx;
        parts.push(`<text class="roof-label" x="${sx(lx) + 4}" y="${sy(ly) - 6}" transform="rotate(${-Math.atan2(sy(ly) - sy(ly * 2), sx(lx * 2) - sx(lx)) * 57.3} ${sx(lx) + 4} ${sy(ly) - 6})">${label}</text>`);
        return ridge;
      };
      const rDram = roof(this.d.bwDram, 'dram', `DRAM ${this.d.bwDram} GB/s`, this.show === 'ops' ? 0.7 : 0.09);
      roof(this.d.bwL2, 'l2', `L2 ${this.d.bwL2} GB/s`, 0.09);
      parts.push(`<text class="roof-label" x="${W - m.r}" y="${sy(this.d.peak) - 6}" text-anchor="end">peak ${this.d.peak} GFLOP/s (AVX-512 FMA)</text>`);

      const legend: [string, string][] = [];
      if (this.show === 'measured') {
        const series = (pts: [number, number][], color: string, name: string) => {
          parts.push(`<polyline class="meas" style="stroke:${color}" points="${pts.map(([x, y]) => `${sx(x)},${sy(y)}`).join(' ')}"/>`);
          for (const [x, y] of pts) parts.push(`<circle class="pt" cx="${sx(x)}" cy="${sy(y)}" r="4.5" style="fill:${color}"><title>${name}: ${x} flops/byte, ${y} GFLOP/s</title></circle>`);
          legend.push([name, color]);
        };
        series(this.d.l2, 'var(--qe-series-1)', 'measured, data in L2');
        series(this.d.dram, 'var(--qe-series-2)', 'measured, data in DRAM');
      } else {
        this.d.ops.forEach((o, k) => {
          const y = Math.min(this.d.bwDram * o.i, this.d.peak);
          parts.push(`<line class="opline" x1="${sx(o.i)}" x2="${sx(o.i)}" y1="${sy(Y0)}" y2="${sy(y)}"/><circle class="pt" cx="${sx(o.i)}" cy="${sy(y)}" r="5" style="fill:var(--qe-series-1)"><title>${o.name}: ${o.note}; at most ${y.toFixed(1)} GFLOP/s from DRAM</title></circle><text class="opnum" x="${sx(o.i) - 8}" y="${sy(y) - 8}" text-anchor="end">${k + 1}</text>`);
        });
        legend.push(['operator, best case from DRAM', 'var(--qe-series-1)']);
      }
      plot.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="Roofline chart">${parts.join('')}</svg>`;
      this.querySelector('[data-legend]')!.innerHTML = legend.map(([n, c]) => `<li><span class="key" style="background:${c}"></span>${n}</li>`).join('');
      const note = this.querySelector<HTMLElement>('[data-note]')!;
      note.textContent =
        this.show === 'measured'
          ? `Each kernel computes a polynomial per value, 2K flops per 8 bytes moved. At low intensity both series climb along a memory roof; from DRAM the turn comes between 8 and 16 flops per byte (the ridge of the DRAM roof is at ${rDram.toFixed(1)}). Neither reaches the peak, and both fall at the highest degrees, probably because each value’s long chain of dependent multiply-adds limits instruction-level parallelism (a hypothesis; this VM has no counters to confirm it).`
          : `Typical query operators do a flop or two per value read, an intensity between 1/12 and 1/4, far left of the ridge at ${rDram.toFixed(1)}: they are memory-bound, and faster arithmetic won’t help them. A sum of doubles can reach at most about ${(this.d.bwDram * 0.125).toFixed(1)} GFLOP/s from DRAM on this core, about 1% of its peak.`;
      if (this.show === 'ops') {
        this.querySelector('[data-legend]')!.innerHTML += this.d.ops.map((o, k) => `<li class="op"><b>${k + 1}</b> ${o.name}: ${o.i < 1 ? `1/${(1 / o.i).toFixed(0)}` : o.i} flops/byte</li>`).join('');
      }
    }
  }
  if (!customElements.get('qe-roofline')) customElements.define('qe-roofline', QeRoofline);
</script>

<style is:global>
  .qe-roof .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.8rem 0 0.4rem;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
  }
  .qe-roof .legend li {
    margin: 0 !important;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .qe-roof .legend li.op {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .qe-roof .legend .key {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }
  .qe-roof .plot {
    border-radius: 8px;
    background: var(--sl-color-black);
  }
  .qe-roof svg {
    display: block;
    font-family: var(--sl-font);
  }
  .qe-roof .grid {
    stroke: var(--sl-color-gray-6);
  }
  .qe-roof .tick {
    fill: var(--sl-color-gray-3);
    font-size: 11px;
  }
  .qe-roof .label {
    fill: var(--sl-color-gray-2);
    font-size: 12px;
    font-weight: 600;
  }
  .qe-roof .roof {
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
  }
  .qe-roof .roof.l2 {
    stroke: var(--sl-color-gray-4);
  }
  .qe-roof .roof-label,
  .qe-roof .opnum {
    paint-order: stroke;
    stroke: var(--sl-color-black);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .qe-roof .opnum {
    fill: var(--sl-color-white);
    font-size: 12px;
    font-weight: 800;
  }
  .qe-roof .legend li.op b {
    color: var(--sl-color-white);
  }
  .qe-roof .roof-label {
    fill: var(--sl-color-gray-2);
    font-size: 10.5px;
    font-weight: 600;
  }
  .qe-roof .meas {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .qe-roof .pt {
    stroke: var(--sl-color-black);
    stroke-width: 2;
  }
  .qe-roof .opline {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }
</style>
