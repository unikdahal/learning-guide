---
// The buffers behind a small Arrow array. Tap a value to make it null and watch the validity
// bitmap (bit i of byte i/8, least significant bit first) and the value or offset buffers
// change; slice the array to see a bit offset and a shifted value pointer. Matches the layout
// printed by lab/crates/m03-representation/examples/physical_layout.rs.
const data = {
  int: [7, -1, 42, 5, 6, 8, 9, 3, 0, 12],
  str: ['join', 'sort', 'hash', '', 'scan', 'agg', 'sql', 'top', 'cte', 'udf'],
};
---

<qe-buffers class="qe-lab qe-buf not-content" data-d={JSON.stringify(data)}>
  <section class="qe-lab-part">
    <div class="qe-lab-chips prose" role="group" aria-label="Array type">
      <button type="button" data-type="int" aria-pressed="true">Int32</button>
      <button type="button" data-type="str" aria-pressed="false">Utf8 (strings)</button>
    </div>
    <div class="qe-lab-chips prose slice" role="group" aria-label="Slice">
      <button type="button" data-slice="0" aria-pressed="true">Whole array</button>
      <button type="button" data-slice="1" aria-pressed="false">slice(3, 5)</button>
    </div>
    <p class="qe-lab-cap lbl">Logical values: tap one to make it null</p>
    <div class="logical" data-logical></div>
    <p class="qe-lab-cap lbl">Validity bitmap, 2 bytes (each byte written most significant bit first)</p>
    <div class="bytes" data-bitmap></div>
    <div data-buffers></div>
    <dl class="facts" data-facts aria-live="polite"></dl>
    <p class="qe-lab-note" data-note aria-live="polite"></p>
  </section>
</qe-buffers>

<script>
  type D = { int: number[]; str: string[] };

  class QeBuffers extends HTMLElement {
    d!: D;
    type: 'int' | 'str' = 'int';
    slice = false;
    nulls = new Set<number>([1, 4]);

    connectedCallback() {
      this.d = JSON.parse(this.dataset.d!);
      const group = (sel: string, f: (b: HTMLButtonElement) => void) =>
        this.querySelectorAll<HTMLButtonElement>(sel).forEach((b) =>
          b.addEventListener('click', () => {
            this.querySelectorAll(sel).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            f(b);
            this.render();
          }),
        );
      group('[data-type]', (b) => (this.type = b.dataset.type as 'int' | 'str'));
      group('[data-slice]', (b) => (this.slice = b.dataset.slice === '1'));
      this.querySelector('[data-logical]')!.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-i]');
        if (!t) return;
        const i = Number(t.dataset.i);
        if (this.nulls.has(i)) this.nulls.delete(i);
        else this.nulls.add(i);
        this.render();
      });
      this.render();
    }

    render() {
      const vals = this.type === 'int' ? this.d.int.map(String) : this.d.str;
      const n = vals.length;
      const inSlice = (i: number) => !this.slice || (i >= 3 && i < 8);
      const show = (v: string) => (this.type === 'str' ? `"${v}"` : v);
      this.querySelector('[data-logical]')!.innerHTML = vals
        .map(
          (v, i) =>
            `<button type="button" class="lv${this.nulls.has(i) ? ' null' : ''}${inSlice(i) ? '' : ' out'}" data-i="${i}" aria-label="value ${i}: ${this.nulls.has(i) ? 'null' : v}, tap to toggle null"><small>${i}</small>${this.nulls.has(i) ? 'null' : show(v)}</button>`,
        )
        .join('');

      const bytes = [0, 0];
      for (let i = 0; i < n; i++) if (!this.nulls.has(i)) bytes[i >> 3] |= 1 << (i & 7);
      this.querySelector('[data-bitmap]')!.innerHTML = bytes
        .map((b, k) => {
          const cells = Array.from({ length: 8 }, (_, j) => {
            const bit = 7 - j;
            const i = k * 8 + bit;
            const used = i < n;
            const on = (b >> bit) & 1;
            return `<span class="bit${used ? '' : ' pad'}${used && !inSlice(i) ? ' out' : ''}${on ? ' on' : ''}"><b>${on}</b><small>${used ? i : '–'}</small></span>`;
          }).join('');
          return `<div class="byte"><span class="bname">byte ${k}</span><div class="bits">${cells}</div></div>`;
        })
        .join('');

      let buffers = '';
      let valueBytes = 0;
      if (this.type === 'int') {
        valueBytes = n * 4;
        buffers = `<p class="qe-lab-cap lbl">Value buffer: ${n} × 4 bytes = ${valueBytes} bytes</p><div class="cells">${this.d.int
          .map(
            (v, i) =>
              `<span class="vc${this.nulls.has(i) ? ' null' : ''}${inSlice(i) ? '' : ' out'}"><small>${i * 4}</small>${this.nulls.has(i) ? '0' : v}</span>`,
          )
          .join('')}<span class="vc padcell"><small>${valueBytes}</small>padding</span></div>`;
      } else {
        const offs = [0];
        let data = '';
        vals.forEach((v, i) => {
          if (!this.nulls.has(i)) data += v;
          offs.push(data.length);
        });
        valueBytes = (n + 1) * 4 + data.length;
        const offIn = (k: number) => !this.slice || (k >= 3 && k <= 8);
        buffers =
          `<p class="qe-lab-cap lbl">Offsets buffer: ${n + 1} × 4 bytes</p><div class="cells">${offs
            .map((o, k) => `<span class="vc off${offIn(k) ? '' : ' out'}"><small>${k}</small>${o}</span>`)
            .join('')}</div>` +
          `<p class="qe-lab-cap lbl">Data buffer: ${data.length} bytes, values run together</p><div class="chars">${[...data]
            .map((c, k) => {
              const owner = offs.findIndex((o, j) => j < n && k >= o && k < offs[j + 1]);
              const first = offs[owner] === k && k > 0;
              return `<span class="ch${inSlice(owner) ? '' : ' out'}${first ? ' first' : ''}" data-owner="${owner}">${c}</span>`;
            })
            .join('')}</div>`;
      }
      this.querySelector('[data-buffers]')!.innerHTML = buffers;

      const sliceNulls = [...this.nulls].filter((i) => inSlice(i)).length;
      const facts: [string, string][] = [
        ['length', this.slice ? '5' : String(n)],
        ['null_count', String(sliceNulls)],
        ['bitmap offset', this.slice ? '3 bits' : '0'],
        [this.type === 'int' ? 'values start at' : 'offsets start at', this.slice ? 'byte 12' : 'byte 0'],
      ];
      this.querySelector('[data-facts]')!.innerHTML = facts.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
      const note = this.slice
        ? `The slice copies nothing. It keeps the same buffers and records an offset of 3: its first value is bit 3 of the bitmap, and its first ${this.type === 'int' ? 'value' : 'offset'} is 12 bytes into the buffer. An offset that isn't a multiple of 8 means kernels read the bitmap at a bit offset, which arrow-rs handles with shifted reads.`
        : this.type === 'int'
          ? `Byte 0 of the bitmap covers values 0 to 7, value 0 in its lowest bit, so read each byte right to left. A null’s slot in the value buffer still exists and holds some value, here 0, that readers must ignore. The values take ${valueBytes} bytes; the specification recommends padding buffers to a multiple of 64 bytes, so SIMD loops can read whole blocks.`
          : `Value i is the bytes from offsets[i] to offsets[i + 1]. Value 3 is the empty string: a zero-length range with its validity bit set. A null also has a zero-length range here, but its bit is 0. Only the bitmap tells the two apart.`;
      this.querySelector<HTMLElement>('[data-note]')!.textContent = note;
    }
  }
  if (!customElements.get('qe-buffers')) customElements.define('qe-buffers', QeBuffers);
</script>

<style is:global>
  .qe-buf .slice {
    margin-top: 0.45rem;
  }
  .qe-buf .lbl {
    margin-top: 0.9rem;
  }
  .qe-buf .logical,
  .qe-buf .cells,
  .qe-buf .chars {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .qe-buf .lv,
  .qe-buf .vc {
    display: grid;
    min-width: 2.9rem;
    padding: 0.2rem 0.35rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    text-align: left;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .qe-buf .lv {
    cursor: pointer;
    border-color: var(--qe-series-1);
  }
  .qe-buf .lv small,
  .qe-buf .vc small,
  .qe-buf .bit small {
    font-size: 0.5625rem;
    color: var(--sl-color-gray-3);
  }
  .qe-buf .lv.null,
  .qe-buf .vc.null {
    border-style: dashed;
    border-color: var(--qe-series-2);
    color: var(--sl-color-gray-3);
  }
  .qe-buf .out {
    opacity: 0.3;
  }
  .qe-buf .padcell {
    border-style: dotted;
    color: var(--sl-color-gray-3);
    flex: 1 1 4rem;
  }
  .qe-buf .bytes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .qe-buf .bname {
    display: block;
    font-size: 0.6875rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 2px;
  }
  .qe-buf .bits {
    display: flex;
    gap: 2px;
  }
  .qe-buf .bit {
    display: grid;
    justify-items: center;
    width: 1.45rem;
    padding: 0.15rem 0;
    border-radius: 4px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
  }
  .qe-buf .bit.on {
    border-color: var(--qe-series-1);
    background: var(--qe-series-1);
    color: var(--sl-color-black);
  }
  .qe-buf .bit.on small {
    color: var(--sl-color-black);
  }
  .qe-buf .bit.pad {
    background: transparent;
    border: 1px dotted var(--sl-color-gray-5);
  }
  .qe-buf .ch {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.7rem;
    border-radius: 4px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--sl-color-white);
  }
  .qe-buf .ch[data-owner='0'],
  .qe-buf .ch[data-owner='2'],
  .qe-buf .ch[data-owner='4'],
  .qe-buf .ch[data-owner='6'],
  .qe-buf .ch[data-owner='8'] {
    background: var(--sl-color-gray-5);
  }
  .qe-buf .ch.first {
    margin-left: 0.4rem;
  }
  .qe-buf .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.35rem;
    margin: 0.9rem 0 0;
  }
  .qe-buf .facts div {
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
  }
  .qe-buf .facts dt {
    font-size: 0.6875rem;
    color: var(--sl-color-gray-3);
  }
  .qe-buf .facts dd {
    margin: 0;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--sl-color-white);
  }
</style>
