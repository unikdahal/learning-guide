---
// Row-group pruning with min/max statistics. Twenty row groups of a ts column are drawn as their
// [min, max] ranges on a time axis; a query asks for a window of time. Groups whose range can't
// overlap the window are skipped without reading. Sort the data and most groups drop out; shuffle
// it and every group spans nearly everything. Measured on 10M rows in
// lab/crates/m03-representation/examples/parquet_stats.rs.
function lcg(seed: number) {
  let s = seed >>> 0;
  return () => ((s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 2 ** 32);
}
const r = lcg(11);
const G = 20;
const PER = 50;
const total = G * PER;
// Event times 0..100 (think hours), roughly uniform, in time order.
const times = Array.from({ length: total }, (_, i) => (i + r() * 0.9) * (100 / total));
const shuffled = [...times];
for (let i = total - 1; i > 0; i--) {
  const j = Math.floor(r() * (i + 1));
  [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
}
const ranges = (arr: number[]) =>
  Array.from({ length: G }, (_, g) => {
    const s = arr.slice(g * PER, (g + 1) * PER);
    return [Math.min(...s), Math.max(...s)].map((x) => Math.round(x * 10) / 10);
  });
// Partly clustered: sorted, then each row swapped with a random row within ±150 positions.
const clustered = [...times];
for (let i = 0; i < total; i++) {
  const j = Math.min(total - 1, Math.max(0, i + Math.floor((r() - 0.5) * 300)));
  [clustered[i], clustered[j]] = [clustered[j], clustered[i]];
}
const data = { sorted: ranges(times), clustered: ranges(clustered), shuffled: ranges(shuffled), rows: PER };
---

<qe-pruning class="qe-lab qe-pr not-content" data-d={JSON.stringify(data)}>
  <section class="qe-lab-part">
    <div class="qe-lab-chips prose" role="group" aria-label="Order of the data when written">
      <button type="button" data-ord="sorted" aria-pressed="true">Sorted by ts</button>
      <button type="button" data-ord="clustered" aria-pressed="false">Roughly in order</button>
      <button type="button" data-ord="shuffled" aria-pressed="false">Shuffled</button>
    </div>
    <label class="win">
      <span>WHERE ts BETWEEN <b data-lo></b> AND <b data-hi></b></span>
      <input type="range" min="0" max="95" value="48" step="1" data-from aria-label="Start of the time window" />
    </label>
    <div class="qe-lab-chips prose" role="group" aria-label="Window width">
      <button type="button" data-w="1" aria-pressed="false">1 hour</button>
      <button type="button" data-w="5" aria-pressed="true">5 hours</button>
      <button type="button" data-w="25" aria-pressed="false">25 hours</button>
    </div>
    <div class="plot" data-plot role="img" aria-label="Row group min-max ranges against the query window"></div>
    <dl class="facts" data-facts aria-live="polite"></dl>
    <p class="qe-lab-note" data-note aria-live="polite"></p>
  </section>
</qe-pruning>

<script>
  type D = { sorted: number[][]; clustered: number[][]; shuffled: number[][]; rows: number };

  class QePruning extends HTMLElement {
    d!: D;
    ord: 'sorted' | 'clustered' | 'shuffled' = 'sorted';
    w = 5;

    connectedCallback() {
      this.d = JSON.parse(this.dataset.d!);
      const group = (sel: string, f: (b: HTMLButtonElement) => void) =>
        this.querySelectorAll<HTMLButtonElement>(sel).forEach((b) =>
          b.addEventListener('click', () => {
            this.querySelectorAll(sel).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            f(b);
            this.render();
          }),
        );
      group('[data-ord]', (b) => (this.ord = b.dataset.ord as 'sorted' | 'clustered' | 'shuffled'));
      group('[data-w]', (b) => (this.w = Number(b.dataset.w)));
      this.querySelector('[data-from]')!.addEventListener('input', () => this.render());
      this.render();
    }

    render() {
      const from = Number(this.querySelector<HTMLInputElement>('[data-from]')!.value);
      const lo = from;
      const hi = Math.min(100, from + this.w);
      this.querySelector('[data-lo]')!.textContent = `${lo}h`;
      this.querySelector('[data-hi]')!.textContent = `${hi}h`;
      const ranges = this.d[this.ord];
      const x = (v: number) => `${v}%`;
      let read = 0;
      const rows = ranges
        .map(([mn, mx], g) => {
          const keep = mx >= lo && mn <= hi;
          if (keep) read++;
          return `<div class="rg${keep ? ' keep' : ''}"><span class="gl">${g}</span><span class="lane"><span class="rng" style="left:${x(mn)};width:calc(${x(mx - mn)} + 3px)"></span></span></div>`;
        })
        .join('');
      this.querySelector('[data-plot]')!.innerHTML =
        `<div class="axis"><span>0h</span><span>50h</span><span>100h</span></div><div class="rows"><span class="wlane"><span class="window" style="left:${x(lo)};width:${x(hi - lo)}"></span></span>${rows}</div>`;
      const G = ranges.length;
      this.querySelector('[data-facts]')!.innerHTML = [
        ['row groups read', `${read} of ${G}`],
        ['pruned by min/max', String(G - read)],
        ['rows decoded', `${read * this.d.rows} of ${G * this.d.rows}`],
      ]
        .map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`)
        .join('');
      const notes = {
        sorted: 'Written in time order, each row group covers its own narrow slice of time, so a short window overlaps only one or two groups and the reader skips the rest using nothing but the footer.',
        clustered: 'Roughly in order, ranges overlap their neighbours: the window touches a few more groups than when sorted, but pruning still removes most of them.',
        shuffled: 'Shuffled, every row group contains times from across the whole range, so every [min, max] overlaps every window. The statistics are correct and useless: nothing can be skipped.',
      };
      this.querySelector<HTMLElement>('[data-note]')!.textContent = notes[this.ord];
    }
  }
  if (!customElements.get('qe-pruning')) customElements.define('qe-pruning', QePruning);
</script>

<style is:global>
  .qe-pr .win {
    display: grid;
    gap: 0.35rem;
    margin: 0.9rem 0 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
  }
  .qe-pr .win b {
    color: var(--sl-color-white);
  }
  .qe-pr input[type='range'] {
    width: 100%;
    accent-color: var(--sl-color-accent);
    min-height: 2rem;
  }
  .qe-pr .plot {
    margin-top: 0.9rem;
    padding: 0.6rem 0.6rem 0.6rem 0;
    border-radius: 8px;
    background: var(--sl-color-black);
  }
  .qe-pr .axis {
    display: flex;
    justify-content: space-between;
    margin-left: 2rem;
    font-size: 0.625rem;
    color: var(--sl-color-gray-3);
  }
  .qe-pr .rows {
    position: relative;
    display: grid;
    gap: 3px;
    margin-top: 0.3rem;
  }
  .qe-pr .wlane {
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 2rem;
    right: 0;
    pointer-events: none;
    z-index: 2;
  }
  .qe-pr .window {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 3px;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
    border-left: 2px solid var(--sl-color-accent);
    border-right: 2px solid var(--sl-color-accent);
    transition: left 0.15s, width 0.25s;
  }
  .qe-pr .rg {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    height: 0.8rem;
  }
  .qe-pr .gl {
    font-size: 0.5625rem;
    color: var(--sl-color-gray-2);
    text-align: right;
    padding-right: 0.4rem;
  }
  .qe-pr .lane {
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  .qe-pr .rng {
    position: absolute;
    top: 1px;
    bottom: 1px;
    border-radius: 3px;
    background: var(--sl-color-gray-5);
    transition: left 0.4s ease, width 0.4s ease, background-color 0.2s;
  }
  .qe-pr .rg.keep .rng {
    background: var(--qe-series-2);
  }
  .qe-pr .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.35rem;
    margin: 0.9rem 0 0;
  }
  .qe-pr .facts div {
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
  }
  .qe-pr .facts dt {
    font-size: 0.6875rem;
    color: var(--sl-color-gray-3);
  }
  .qe-pr .facts dd {
    margin: 0;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--sl-color-white);
  }
</style>
