---
// Part 1: the result type of decimal arithmetic, using the rules DataFusion 55 inherits from
// arrow-rs (arrow-arith numeric.rs, which follows Hive): values are exact, computed with BigInt,
// and division truncates as arrow's integer division does. Part 2: adding 0.1 N times in
// DECIMAL, DOUBLE and REAL, computed live in the browser (Math.fround gives real f32 rounding).
---

<qe-decimal class="qe-lab qe-dec not-content">
  <section class="qe-lab-part">
    <p class="qe-lab-h">What type does decimal arithmetic return?</p>
    <div class="qe-lab-chips" role="group" aria-label="Operation">
      <button type="button" data-op="add" aria-pressed="false">a + b</button>
      <button type="button" data-op="sub" aria-pressed="false">a − b</button>
      <button type="button" data-op="mul" aria-pressed="false">a × b</button>
      <button type="button" data-op="div" aria-pressed="true">a ÷ b</button>
    </div>
    <div class="operands">
      <div class="operand" data-side="a">
        <label><span class="qe-lab-cap">a, value</span><input inputmode="decimal" value="2" data-val aria-label="Value of a" /></label>
        <div class="type">
          <span>DECIMAL(</span>
          <span class="step"><button type="button" data-d="p-" aria-label="Decrease precision of a">−</button><b data-p>10</b><button type="button" data-d="p+" aria-label="Increase precision of a">+</button></span>
          <span>,</span>
          <span class="step"><button type="button" data-d="s-" aria-label="Decrease scale of a">−</button><b data-s>2</b><button type="button" data-d="s+" aria-label="Increase scale of a">+</button></span>
          <span>)</span>
        </div>
        <p class="stored" data-stored></p>
      </div>
      <div class="operand" data-side="b">
        <label><span class="qe-lab-cap">b, value</span><input inputmode="decimal" value="3" data-val aria-label="Value of b" /></label>
        <div class="type">
          <span>DECIMAL(</span>
          <span class="step"><button type="button" data-d="p-" aria-label="Decrease precision of b">−</button><b data-p>10</b><button type="button" data-d="p+" aria-label="Increase precision of b">+</button></span>
          <span>,</span>
          <span class="step"><button type="button" data-d="s-" aria-label="Decrease scale of b">−</button><b data-s>2</b><button type="button" data-d="s+" aria-label="Increase scale of b">+</button></span>
          <span>)</span>
        </div>
        <p class="stored" data-stored></p>
      </div>
    </div>
    <div class="result" aria-live="polite">
      <p class="qe-lab-cap">Result in DataFusion</p>
      <p class="rtype" data-rtype></p>
      <p class="rval" data-rval></p>
      <ul class="rules" data-rules></ul>
    </div>
    <p class="qe-lab-note" data-note></p>
  </section>

  <section class="qe-lab-part">
    <p class="qe-lab-h">Add 0.1 to itself, again and again</p>
    <div class="qe-lab-chips prose" role="group" aria-label="How many times">
      <button type="button" data-n="10" aria-pressed="false">10 times</button>
      <button type="button" data-n="1000" aria-pressed="false">1,000</button>
      <button type="button" data-n="1000000" aria-pressed="true">1,000,000</button>
      <button type="button" data-n="10000000" aria-pressed="false">10,000,000</button>
    </div>
    <table class="sums">
      <thead><tr><th>Type</th><th>Sum</th><th>Error</th></tr></thead>
      <tbody data-sums></tbody>
    </table>
    <p class="qe-lab-note" data-sumnote>
      Computed in your browser as you choose. 0.1 has no exact binary representation, so every
      floating-point addition rounds, and the rounding errors pile up. DECIMAL stores 0.1 as the
      integer 1 with scale 1, so its sum is exact.
    </p>
  </section>
</qe-decimal>

<script>
  type Side = { p: number; s: number; el: HTMLElement };
  const MAX = 38;
  const pow10 = (n: number) => 10n ** BigInt(n);
  const babs = (x: bigint) => (x < 0n ? -x : x);

  /** Parses a decimal string and rounds it half away from zero to `s` fractional digits. */
  function toScaled(text: string, s: number): bigint | null {
    const m = text.trim().match(/^([+-]?)(\d*)(?:\.(\d*))?$/);
    if (!m || (m[2] === '' && (m[3] ?? '') === '')) return null;
    const neg = m[1] === '-';
    const int = m[2] || '0';
    const frac = m[3] ?? '';
    let digits = BigInt(int + frac.padEnd(s, '0').slice(0, s));
    const rest = frac.slice(s);
    if (rest.length && rest[0] >= '5') digits += 1n;
    return neg ? -digits : digits;
  }

  function fmt(v: bigint, s: number): string {
    const neg = v < 0n;
    let t = babs(v).toString().padStart(s + 1, '0');
    if (s > 0) t = t.slice(0, -s) + '.' + t.slice(-s);
    return (neg ? '-' : '') + t;
  }

  function maxOf(p: number, s: number) {
    return fmt(pow10(p) - 1n, s);
  }

  class QeDecimal extends HTMLElement {
    op = 'div';
    sides: Record<'a' | 'b', Side> = {} as never;
    n = 1000000;

    connectedCallback() {
      for (const k of ['a', 'b'] as const) {
        const el = this.querySelector<HTMLElement>(`[data-side="${k}"]`)!;
        this.sides[k] = { p: 10, s: 2, el };
        el.querySelector('input')!.addEventListener('input', () => this.render());
        el.querySelectorAll<HTMLButtonElement>('[data-d]').forEach((b) =>
          b.addEventListener('click', () => {
            const side = this.sides[k];
            const d = b.dataset.d!;
            if (d === 'p+') side.p = Math.min(MAX, side.p + 1);
            if (d === 'p-') side.p = Math.max(1, side.p - 1);
            if (d === 's+') side.s = Math.min(side.p, side.s + 1);
            if (d === 's-') side.s = Math.max(0, side.s - 1);
            side.s = Math.min(side.s, side.p);
            this.render();
          }),
        );
      }
      this.querySelectorAll<HTMLButtonElement>('[data-op]').forEach((b) =>
        b.addEventListener('click', () => {
          this.op = b.dataset.op!;
          this.querySelectorAll('[data-op]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.render();
        }),
      );
      this.querySelectorAll<HTMLButtonElement>('[data-n]').forEach((b) =>
        b.addEventListener('click', () => {
          this.n = Number(b.dataset.n);
          this.querySelectorAll('[data-n]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.sums();
        }),
      );
      this.render();
      this.sums();
    }

    /** Casts an operand to its declared type, as a value stored in a DECIMAL(p, s) column. */
    stored(k: 'a' | 'b'): bigint | string {
      const { p, s, el } = this.sides[k];
      el.querySelector('[data-p]')!.textContent = String(p);
      el.querySelector('[data-s]')!.textContent = String(s);
      const text = el.querySelector('input')!.value;
      const v = toScaled(text, s);
      const out = el.querySelector<HTMLElement>('[data-stored]')!;
      out.classList.remove('bad');
      if (v === null) {
        out.textContent = 'Not a number.';
        out.classList.add('bad');
        return 'nan';
      }
      if (babs(v) >= pow10(p)) {
        out.textContent = `Too large: DECIMAL(${p},${s}) holds at most ${maxOf(p, s)}. DataFusion raises an error.`;
        out.classList.add('bad');
        return 'big';
      }
      const shown = fmt(v, s);
      const frac = text.trim().split('.')[1] ?? '';
      const dropped = frac.slice(s);
      out.textContent = /[1-9]/.test(dropped)
        ? `Stored as ${shown}: rounded half away from zero to ${s} decimal place${s === 1 ? '' : 's'}`
        : `Stored as ${shown}`;
      return v;
    }

    render() {
      const a = this.stored('a');
      const b = this.stored('b');
      const { p: p1, s: s1 } = this.sides.a;
      const { p: p2, s: s2 } = this.sides.b;
      let p = 0;
      let s = 0;
      let rules: string[] = [];
      let raw = 0;
      if (this.op === 'add' || this.op === 'sub') {
        s = Math.max(s1, s2);
        raw = s + Math.max(p1 - s1, p2 - s2) + 1;
        rules = [
          `scale = max(s₁, s₂) = max(${s1}, ${s2}) = ${s}`,
          `precision = scale + max(p₁ − s₁, p₂ − s₂) + 1 = ${s} + ${Math.max(p1 - s1, p2 - s2)} + 1 = ${raw}`,
        ];
      } else if (this.op === 'mul') {
        s = s1 + s2;
        raw = p1 + p2 + 1;
        rules = [`scale = s₁ + s₂ = ${s1} + ${s2} = ${s}`, `precision = p₁ + p₂ + 1 = ${p1} + ${p2} + 1 = ${raw}`];
      } else {
        s = Math.min(MAX, s1 + 4);
        raw = p1 - s1 + s2 + s;
        rules = [
          `scale = s₁ + 4 = ${s1} + 4 = ${s1 + 4}${s1 + 4 > MAX ? `, capped at ${MAX}` : ''}`,
          `precision = p₁ − s₁ + s₂ + scale = ${p1} − ${s1} + ${s2} + ${s} = ${raw}`,
        ];
      }
      p = Math.min(MAX, raw);
      if (raw > MAX) rules.push(`precision capped at ${MAX}, the most a 128-bit decimal holds`);
      const rtype = this.querySelector<HTMLElement>('[data-rtype]')!;
      const rval = this.querySelector<HTMLElement>('[data-rval]')!;
      const note = this.querySelector<HTMLElement>('[data-note]')!;
      const scaleTooBig = this.op === 'mul' && s > MAX;
      rtype.textContent = scaleTooBig ? 'Error' : `DECIMAL(${p}, ${s})`;
      this.querySelector('[data-rules]')!.innerHTML = rules.map((r) => `<li>${r}</li>`).join('');
      rval.classList.remove('bad');

      if (scaleTooBig) {
        rval.textContent = `Output scale ${s} would exceed the maximum scale of ${MAX}.`;
        rval.classList.add('bad');
        note.textContent = 'The SQL standard does not allow a multiplication to round away digits, so arrow-rs rejects it rather than lose precision.';
        return;
      }
      if (typeof a === 'string' || typeof b === 'string') {
        rval.textContent = 'Fix the operands above to see the value.';
        note.textContent = 'An operand must first fit its own declared type.';
        return;
      }
      let v: bigint;
      if (this.op === 'add' || this.op === 'sub') {
        const l = a * pow10(s - s1);
        const r = b * pow10(s - s2);
        v = this.op === 'add' ? l + r : l - r;
      } else if (this.op === 'mul') {
        v = a * b;
      } else {
        if (b === 0n) {
          rval.textContent = 'Divide by zero error';
          rval.classList.add('bad');
          note.textContent = 'Dividing by a zero decimal is an error, not NULL and not infinity.';
          return;
        }
        const mulPow = s - s1 + s2;
        v = mulPow >= 0 ? (a * pow10(mulPow)) / b : a / (b * pow10(-mulPow));
      }
      rval.textContent = `= ${fmt(v, s)}`;
      if (babs(v) >= pow10(p)) {
        rval.classList.add('bad');
        note.textContent = `The exact answer needs more than ${p} digits, and the type is already at the ${MAX}-digit limit. In the lab, DataFusion did not catch this: it printed a wrong value, and a sum of such values wrapped around to a negative number.`;
      } else if (this.op === 'div') {
        const mulPow = s - s1 + s2;
        const exactRemainder = mulPow >= 0 ? (a * pow10(mulPow)) % b : a % (b * pow10(-mulPow));
        note.textContent =
          exactRemainder === 0n
            ? 'The division is exact at this scale. The result type keeps four more fractional digits than a, which is the same increment MySQL uses by default.'
            : 'The quotient doesn’t terminate, so it is cut to the result scale. arrow-rs divides the scaled integers, which truncates toward zero instead of rounding: 2 ÷ 3 gives 0.666666, not 0.666667.';
      } else if (this.op === 'mul') {
        note.textContent = 'A product needs as many fractional digits as both inputs together, and the precision grows to fit the largest possible product, so nothing is lost.';
      } else {
        note.textContent = 'The result keeps the larger scale, and one extra digit of precision leaves room for a carry: 99.9 + 0.1 needs a digit that neither input had.';
      }
    }

    sums() {
      const n = this.n;
      let f32 = 0;
      let f64 = 0;
      const tenth32 = Math.fround(0.1);
      for (let i = 0; i < n; i++) {
        f32 = Math.fround(f32 + tenth32);
        f64 += 0.1;
      }
      const exact = n / 10;
      const err = (x: number) => {
        const e = Math.abs(x - exact) / exact;
        if (e === 0) return 'exact';
        return e < 1e-9 ? `${(e * 100).toExponential(1)} %` : `${(e * 100).toFixed(e * 100 < 0.01 ? 6 : 2)} %`;
      };
      const rows = [
        ['DECIMAL(20, 1)', exact.toLocaleString('en-US', { minimumFractionDigits: 1 }), 'exact'],
        ['DOUBLE (64-bit)', String(f64), err(f64)],
        ['REAL (32-bit)', String(f32), err(f32)],
      ];
      this.querySelector('[data-sums]')!.innerHTML = rows
        .map(([t, v, e]) => `<tr><td>${t}</td><td><code>${v}</code></td><td class="${e === 'exact' ? 'ok' : 'off'}">${e}</td></tr>`)
        .join('');
    }
  }
  if (!customElements.get('qe-decimal')) customElements.define('qe-decimal', QeDecimal);
</script>

<style is:global>
  .qe-dec .operands {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .qe-dec .operand {
    padding: 0.7rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
  }
  .qe-dec .operand label {
    display: block;
  }
  .qe-dec input {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 1rem;
  }
  .qe-dec .type {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.55rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
  }
  .qe-dec .step {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 6px;
    overflow: hidden;
  }
  .qe-dec .step button {
    width: 2.1rem;
    height: 2.1rem;
    border: 0;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font-size: 1rem;
    cursor: pointer;
  }
  .qe-dec .step b {
    min-width: 1.9rem;
    text-align: center;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }
  .qe-dec .stored {
    margin: 0.45rem 0 0;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .qe-dec .bad {
    color: var(--qe-warn) !important;
  }
  .qe-dec .result {
    margin-top: 0.8rem;
    padding: 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--sl-color-black));
  }
  .qe-dec .rtype {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .qe-dec .rval {
    margin: 0.2rem 0 0;
    font-family: var(--sl-font-mono);
    font-size: 0.9375rem;
    color: var(--sl-color-gray-1);
    overflow-wrap: anywhere;
  }
  .qe-dec .rules {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .qe-dec .rules li {
    margin: 0;
  }
  .qe-dec .sums {
    width: 100%;
    margin: 0.9rem 0 0;
    border-collapse: collapse;
    font-size: 0.8125rem;
    display: table;
  }
  .qe-dec .sums th {
    text-align: left;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    padding: 0.3rem 0.4rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: none;
  }
  .qe-dec .sums td {
    padding: 0.4rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-1);
    overflow-wrap: anywhere;
  }
  .qe-dec .sums code {
    font-size: 0.75rem;
    background: none;
    padding: 0;
  }
  .qe-dec .sums td.ok {
    color: var(--sl-color-accent-high);
    font-weight: 650;
  }
  .qe-dec .sums td.off {
    color: var(--qe-warn);
    font-weight: 650;
    white-space: nowrap;
  }
</style>
