---
// Codd's definition made visible: segment × region holds every possible pair of values; the
// relation π segment, region (customer) is the subset of those pairs that actually occur.
import { customers } from './data';

const segments = ['retail', 'wholesale', 'government'];
const regions = ['AFRICA', 'ASIA', 'EUROPE'];
const present = new Set(customers.map((c) => `${c.segment}|${c.region}`));
const count = present.size;
---

<figure class="qe-dp not-content">
  <table class="domain-table" aria-label={`segment × region has 9 pairs; ${count} occur in the customer data`}>
    <thead><tr><th scope="col">Segment / region</th>{regions.map(r=><th scope="col">{r}</th>)}</tr></thead>
    <tbody>{segments.map(segment=><tr><th scope="row">{segment}</th>{regions.map(region=>{
      const on=present.has(`${segment}|${region}`);
      return <td class:list={{on}}><span class="sr-only">{segment}, {region}: </span>{on ? 'Present' : 'Absent'}</td>;
    })}</tr>)}</tbody>
  </table>
  <figcaption>
    All nine cells together are the Cartesian product <code>segment × region</code>: every pair that could exist. The{' '}
    {count} filled cells are the pairs that occur in the customer data, the relation{' '}
    <code>π segment, region (customer)</code>. A relation is always some subset of the product of its domains.
  </figcaption>
</figure>

<style>
  .qe-dp {
    margin: 2rem 0;
    padding: 1.2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    font-family: var(--sl-font);
  }
  figcaption {
    margin-top: 0.9rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  figcaption code {
    font-size: 0.85em;
  }
  @media (max-width: 49.99rem) {
    .qe-dp {
      margin-inline: var(--qe-bleed);
      border-radius: 0;
      border-inline: 0;
      padding: 1rem;
    }

  }

.domain-table {width:100%;border-collapse:separate;border-spacing:4px;table-layout:fixed;white-space:normal;font-size:0.75rem;}
.domain-table th,.domain-table td {padding:0.4rem;overflow-wrap:anywhere;text-align:center;}
.domain-table td {border:1px dashed var(--sl-color-gray-4);border-radius:6px;color:var(--sl-color-gray-1);}
.domain-table td.on {background:var(--sl-color-accent-low);border-color:var(--sl-color-accent);color:var(--sl-color-accent-high);}
</style>
