---
// Codd's definition made visible: segment × region holds every possible pair of values; the
// relation π segment, region (customer) is the subset of those pairs that actually occur.
import { customers } from './data';

const segments = ['retail', 'wholesale', 'government'];
const regions = ['AFRICA', 'ASIA', 'EUROPE'];
const present = new Set(customers.map((c) => `${c.segment}|${c.region}`));
const count = present.size;
---

<figure class="qe-dp not-content">
  <div class="grid" role="table" aria-label={`segment × region has 9 pairs; ${count} occur in the customer data`}>
    <span class="corner" role="presentation"></span>
    {regions.map((r) => <span class="colh" role="columnheader">{r}</span>)}
    {
      segments.map((s) => (
        <>
          <span class="rowh" role="rowheader">{s}</span>
          {regions.map((r) => {
            const on = present.has(`${s}|${r}`);
            return (
              <span class:list={['cell', { on }]} role="cell" aria-label={`${s}, ${r}: ${on ? 'in the relation' : 'not in it'}`}>
                {on ? '(' + s + ', ' + r + ')' : ''}
              </span>
            );
          })}
        </>
      ))
    }
  </div>
  <figcaption>
    All nine cells together are the Cartesian product <code>segment × region</code>: every pair that could exist. The{' '}
    {count} filled cells are the pairs that occur in the customer data, the relation{' '}
    <code>π segment, region (customer)</code>. A relation is always some subset of the product of its domains.
  </figcaption>
</figure>

<style>
  .qe-dp {
    margin: 2rem 0;
    padding: 1.2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    font-family: var(--sl-font);
  }
  .grid {
    display: grid;
    grid-template-columns: 6.5rem repeat(3, minmax(0, 1fr));
    gap: 5px;
  }
  .colh,
  .rowh {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .colh {
    text-align: center;
    padding-bottom: 0.2rem;
  }
  .rowh {
    display: grid;
    align-items: center;
  }
  .cell {
    display: grid;
    place-items: center;
    min-height: 3.25rem;
    padding: 0.3rem;
    border-radius: 7px;
    border: 1.5px dashed var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    line-height: 1.3;
    text-align: center;
    color: var(--sl-color-black);
    overflow-wrap: anywhere;
  }
  .cell.on {
    border: 1.5px solid var(--sl-color-accent);
    background: var(--sl-color-accent);
    font-weight: 600;
  }
  figcaption {
    margin-top: 0.9rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  figcaption code {
    font-size: 0.85em;
  }
  @media (max-width: 49.99rem) {
    .qe-dp {
      margin-inline: var(--qe-bleed);
      border-radius: 0;
      border-inline: 0;
      padding: 1rem;
    }
    .grid {
      grid-template-columns: 5rem repeat(3, minmax(0, 1fr));
      gap: 4px;
    }
    .cell {
      font-size: 0;
      min-height: 2.75rem;
    }
    .cell.on::after {
      content: '✓';
      font-size: 1rem;
      font-family: var(--sl-font);
      font-weight: 800;
    }
  }
</style>
