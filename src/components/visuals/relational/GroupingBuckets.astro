      margin-inline: var(--qe-bleed);
      border-radius: 0;
      border-inline: 0;
      padding: 1rem;
    }
    .qe-gb .stages {
      grid-template-columns: 1fr 1fr;
    }
    .qe-gb .stages section:first-child {
      grid-column: 1 / -1;
    }
    .qe-gb .rows {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
