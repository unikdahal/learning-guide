---
// Small, hand-drawn circuit diagrams for the "Electronics from zero" lessons.
// Resistors use the IEC box symbol; batteries put the long (+) plate on top.
// Colours come from theme variables so the drawings work in light and dark mode.
interface Props {
  name: 'loop' | 'series-parallel' | 'kcl' | 'nodal' | 'star-delta' | 'bridge' | 'superposition' | 'thevenin' | 'norton' | 'cap-ind' | 'sine' | 'three-phase' | 'power-triangle' | 'pn-junction' | 'bjt' | 'vdb' | 'opamp';
  label: string;
}
const { name, label } = Astro.props;
const id = `cx-${name}`;

/** A resistor box centred on (cx, cy), rotated by `deg`. */
const box = (cx: number, cy: number, deg = 0) =>
  `<rect class="r" x="${cx - 18}" y="${cy - 7}" width="36" height="14" transform="rotate(${deg} ${cx} ${cy})"/>`;
/** A vertical battery centred on (x, cy): long + plate above, short − plate below. */
const cell = (x: number, cy: number) =>
  `<rect class="gap" x="${x - 14}" y="${cy - 5}" width="28" height="10"/>` +
  `<line class="w" x1="${x - 13}" y1="${cy - 4}" x2="${x + 13}" y2="${cy - 4}"/>` +
  `<line class="w thick" x1="${x - 6}" y1="${cy + 4}" x2="${x + 6}" y2="${cy + 4}"/>`;
const t = (x: number, y: number, s: string, cls = '') => `<text x="${x}" y="${y}" class="${cls}">${s}</text>`;
const arrow = (x1: number, y1: number, x2: number, y2: number, cls = 'i') =>
  `<line class="${cls}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" marker-end="url(#${id}-a${cls === 'e' ? 'e' : ''})"/>`;

/** An open terminal (small hollow circle) with a label. */
const term = (x: number, y: number, s: string) =>
  `<circle class="term" cx="${x}" cy="${y}" r="5"/>` + t(x + 10, y + 5, s, 'strong');
/** Current source: circle with an upward arrow, centred on (x, cy). */
const isrc = (x: number, cy: number) =>
  `<circle class="r" cx="${x}" cy="${cy}" r="18"/>` +
  `<line class="w" x1="${x}" y1="${cy + 10}" x2="${x}" y2="${cy - 6}"/>` +
  `<path class="dot" d="M${x - 5} ${cy - 4} L${x} ${cy - 12} L${x + 5} ${cy - 4} Z"/>`;
/** One copy of the two-source circuit, with either source replaced by a plain wire (a short). */
const twoSource = (ox: number, left: boolean, right: boolean) => {
  const L = ox + 30, N = ox + 180, R = ox + 330;
  return (
    `<path class="w" d="M${L} 60 H${R} V200 H${L} Z M${N} 60 V200"/>` +
    (left ? cell(L, 130) + t(L - 48, 125, '10 V') : t(L + 8, 135, 'short', 'small')) +
    (right ? cell(R, 130) + t(R + 18, 125, '6 V') : t(R - 46, 135, 'short', 'small')) +
    box(ox + 105, 60) + box(ox + 255, 60) + box(N, 130, 90) +
    t(ox + 92, 44, '2 Ω') + t(ox + 242, 44, '4 Ω') + t(N + 16, 135, '4 Ω')
  );
};

/** A wire-coloured arrow (for transistor emitter arrows). */
const warrow = (x1: number, y1: number, x2: number, y2: number) =>
  `<line class="w" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" marker-end="url(#${id}-aw)"/>`;
/** Ground symbol hanging below (x, y). */
const gnd = (x: number, y: number) =>
  `<line class="w" x1="${x}" y1="${y}" x2="${x}" y2="${y + 8}"/>` +
  `<line class="w" x1="${x - 12}" y1="${y + 8}" x2="${x + 12}" y2="${y + 8}"/>` +
  `<line class="w" x1="${x - 7}" y1="${y + 13}" x2="${x + 7}" y2="${y + 13}"/>` +
  `<line class="w" x1="${x - 3}" y1="${y + 18}" x2="${x + 3}" y2="${y + 18}"/>`;
/** A bipolar transistor: base bar at x, centred on y. NPN: collector up, emitter down, arrow out. PNP: emitter up (arrow in), collector down. */
const bjt = (x: number, y: number, npn: boolean) =>
  `<line class="w thick" x1="${x}" y1="${y - 28}" x2="${x}" y2="${y + 28}"/>` +
  (npn
    ? `<line class="w" x1="${x}" y1="${y - 12}" x2="${x + 36}" y2="${y - 38}"/>` + warrow(x, y + 12, x + 36, y + 38)
    : warrow(x + 36, y - 38, x + 4, y - 15) + `<line class="w" x1="${x}" y1="${y + 12}" x2="${x + 36}" y2="${y + 38}"/>`);
/** Op-amp triangle with inputs at x (− on top, + below), output tip at x + 90. */
const opamp = (x: number, y: number) =>
  `<path class="r" d="M${x} ${y - 45} L${x} ${y + 45} L${x + 90} ${y} Z"/>` +
  t(x + 6, y - 14, '−', 'strong') + t(x + 6, y + 26, '+', 'strong');

let vb = '0 0 400 240';
let body = '';

if (name === 'loop') {
  vb = '0 0 400 250';
  body =
    `<path class="w" d="M70 60 H300 V180 H70 Z"/>` +
    cell(70, 120) +
    box(300, 120, 90) +
    t(88, 112, '+') + t(88, 140, '−') +
    t(22, 125, 'V') + t(320, 125, 'R') +
    arrow(130, 44, 240, 44) + t(130, 32, 'conventional current I (+ → −)', 'small i-t') +
    // the bottom wire carries conventional current right→left, so electrons drift left→right
    arrow(130, 200, 240, 200, 'e') + t(118, 228, 'electrons drift the other way', 'small e-t');
} else if (name === 'series-parallel') {
  vb = '0 0 640 256';
  body =
    // series
    `<path class="w" d="M40 60 H270 V190 H40 Z"/>` +
    cell(40, 125) + box(110, 60) + box(200, 60) +
    t(100, 44, 'R1') + t(190, 44, 'R2') +
    t(40, 240, 'Series: same current', 'small') +
    // parallel
    `<path class="w" d="M360 60 H580 V190 H360 Z M470 60 V190"/>` +
    cell(360, 125) + box(470, 125, 90) + box(580, 125, 90) +
    t(488, 130, 'R1') + t(598, 130, 'R2') +
    t(360, 240, 'Parallel: same voltage', 'small');
} else if (name === 'kcl') {
  vb = '0 0 380 230';
  body =
    arrow(30, 110, 170, 110) + arrow(190, 20, 190, 98) +
    arrow(202, 110, 350, 110) +
    `<circle class="dot" cx="190" cy="110" r="6"/>` +
    t(60, 98, 'I1 = 3 A in') + t(200, 50, 'I2 = 2 A in') + t(240, 98, 'I3 = ? out') +
    t(60, 170, 'Charge can’t pile up at a node:', 'small') +
    t(60, 192, 'in = out, so I3 = 3 + 2 = 5 A', 'small');
} else if (name === 'nodal') {
  vb = '-40 0 500 260';
  body =
    `<path class="w" d="M40 60 H380 V200 H40 Z M210 60 V200"/>` +
    cell(40, 130) + cell(380, 130) +
    box(120, 60) + box(300, 60) + box(210, 130, 90) +
    `<circle class="dot" cx="210" cy="60" r="5"/>` +
    t(104, 44, '2 Ω') + t(284, 44, '4 Ω') + t(226, 135, '4 Ω') +
    t(200, 40, 'V', 'strong') +
    t(-36, 135, '10 V') + t(400, 135, '6 V') +
    t(150, 228, 'bottom wire = 0 V (reference)', 'small');
} else if (name === 'star-delta') {
  vb = '0 0 620 250';
  body =
    // delta
    `<path class="w" d="M120 40 L40 190 H200 Z"/>` +
    box(80, 115, 118) + box(160, 115, 62) + box(120, 190) +
    `<circle class="dot" cx="120" cy="40" r="5"/><circle class="dot" cx="40" cy="190" r="5"/><circle class="dot" cx="200" cy="190" r="5"/>` +
    t(113, 26, 'a', 'strong') + t(20, 205, 'b', 'strong') + t(210, 205, 'c', 'strong') +
    t(20, 110, 'Rab') + t(178, 110, 'Rca') + t(104, 222, 'Rbc') +
    t(70, 246, 'Delta (Δ)', 'small') +
    // star
    `<path class="w" d="M470 40 V125 M470 125 L390 190 M470 125 L550 190"/>` +
    box(470, 82, 90) + box(430, 157, 141) + box(510, 157, 39) +
    `<circle class="dot" cx="470" cy="40" r="5"/><circle class="dot" cx="390" cy="190" r="5"/><circle class="dot" cx="550" cy="190" r="5"/><circle class="dot" cx="470" cy="125" r="4"/>` +
    t(463, 26, 'a', 'strong') + t(370, 205, 'b', 'strong') + t(560, 205, 'c', 'strong') +
    t(488, 86, 'Ra') + t(396, 150, 'Rb') + t(528, 150, 'Rc') + t(482, 130, 'n', 'small') +
    t(430, 246, 'Star (Y)', 'small');
} else if (name === 'bridge') {
  vb = '0 0 380 250';
  body =
    `<path class="w" d="M20 120 H60 L180 40 L300 120 L180 200 L60 120 M180 40 V200 M300 120 H350"/>` +
    box(120, 80, -33.7) + box(240, 80, 33.7) + box(120, 160, 33.7) + box(240, 160, -33.7) + box(180, 120, 90) +
    `<circle class="dot" cx="60" cy="120" r="5"/><circle class="dot" cx="300" cy="120" r="5"/><circle class="dot" cx="180" cy="40" r="5"/><circle class="dot" cx="180" cy="200" r="5"/>` +
    t(48, 108, 'A', 'strong') + t(304, 108, 'B', 'strong') + t(174, 28, 'C', 'strong') + t(174, 226, 'D', 'strong') +
    t(86, 62, '2 Ω') + t(248, 62, '4 Ω') + t(86, 192, '3 Ω') + t(248, 192, '6 Ω') + t(194, 125, '5 Ω');
} else if (name === 'superposition') {
  vb = '-30 0 800 250';
  body =
    twoSource(0, true, false) + t(60, 240, 'Only the 10 V source (6 V shorted)', 'small') +
    twoSource(380, false, true) + t(440, 240, 'Only the 6 V source (10 V shorted)', 'small');
} else if (name === 'thevenin') {
  vb = '0 0 760 250';
  body =
    `<path class="w" d="M40 60 H300 M40 200 H300 M40 60 V200 M210 60 V200"/>` +
    cell(40, 130) + box(120, 60) + box(210, 130, 90) +
    t(4, 120, '12 V') + t(106, 44, '4 Ω') + t(226, 135, '12 Ω') +
    term(300, 60, 'a') + term(300, 200, 'b') +
    t(60, 240, 'The real circuit, seen from a–b', 'small') +
    t(360, 138, '≡', 'big') +
    `<path class="w" d="M460 60 H680 M460 200 H680 M460 60 V200"/>` +
    cell(460, 130) + box(560, 60) +
    t(400, 120, 'Vth') + t(404, 140, '9 V', 'small') + t(536, 44, 'Rth = 3 Ω') +
    term(680, 60, 'a') + term(680, 200, 'b') +
    t(470, 240, 'Thevenin equivalent', 'small');
} else if (name === 'norton') {
  vb = '0 0 380 250';
  body =
    `<path class="w" d="M70 60 H300 M70 200 H300 M70 60 V112 M70 148 V200 M200 60 V200"/>` +
    isrc(70, 130) + box(200, 130, 90) +
    t(4, 120, 'In') + t(4, 140, '3 A', 'small') + t(216, 135, 'Rn = 3 Ω') +
    term(300, 60, 'a') + term(300, 200, 'b') +
    t(60, 240, 'Norton equivalent of the same circuit', 'small');
} else if (name === 'cap-ind') {
  vb = '0 0 640 230';
  const plus = [62, 86, 110, 134].map((y) => t(112, y + 5, '+', 'strong')).join('');
  const minus = [62, 86, 110, 134].map((y) => t(180, y + 5, '−', 'strong')).join('');
  const field = [70, 100, 130].map((y) => arrow(136, y, 164, y)).join('');
  let coil = 'M380 120 H400';
  for (let k = 0; k < 5; k++) coil += ' a12 14 0 0 1 24 0';
  coil += ' H540';
  body =
    `<path class="w" d="M40 100 H130 M170 100 H260"/>` +
    `<line class="w thick" x1="130" y1="50" x2="130" y2="150"/><line class="w thick" x1="170" y1="50" x2="170" y2="150"/>` +
    plus + minus + field +
    t(110, 36, '+Q') + t(166, 36, '−Q') +
    t(96, 178, 'gap: insulator', 'small') + t(108, 198, '(dielectric)', 'small') +
    t(60, 226, 'Capacitor: stores energy in an electric field', 'small') +
    `<path class="w" d="${coil}"/>` +
    `<ellipse class="field" cx="460" cy="112" rx="96" ry="52"/>` +
    t(436, 160, 'L', 'strong') + t(412, 50, 'magnetic field', 'small') +
    t(360, 226, 'Inductor: stores energy in a magnetic field', 'small');
} else if (name === 'sine') {
  vb = '0 0 440 256';
  let d = '';
  for (let k = 0; k <= 120; k++) {
    const x = 30 + (k / 120) * 260;
    const y = 120 - 80 * Math.sin((k / 120) * 2 * Math.PI);
    d += `${k ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  const rms = 120 - 0.707 * 80;
  body =
    `<line class="axisd" x1="20" y1="120" x2="300" y2="120"/>` +
    `<path class="wave" d="${d}"/>` +
    `<line class="rms" x1="30" y1="${rms}" x2="290" y2="${rms}"/>` + t(310, rms + 5, 'Vrms = 0.707 Vm', 'small') +
    arrow(95, 120, 95, 42) + t(102, 104, 'Vm', 'small') +
    `<line class="i" x1="304" y1="42" x2="304" y2="198" marker-start="url(#${id}-a)" marker-end="url(#${id}-a)"/>` + t(312, 150, 'Vpp = 2Vm', 'small') +
    `<path class="w" d="M30 226 V236 H290 V226"/>` + t(100, 254, 'one period T = 1/f', 'small') +
    t(22, 140, '0', 'small') + t(152, 140, 'T/2', 'small');
} else if (name === 'three-phase') {
  vb = '0 0 440 220';
  const wave = (shift: number) => {
    let d = '';
    for (let k = 0; k <= 120; k++) {
      const x = 40 + (k / 120) * 360;
      const y = 105 - 70 * Math.sin((k / 120) * 2 * Math.PI - shift);
      d += `${k ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
    }
    return d;
  };
  body =
    `<line class="axisd" x1="30" y1="105" x2="410" y2="105"/>` +
    `<path class="wave" d="${wave(0)}"/>` +
    `<path class="wave2" d="${wave((2 * Math.PI) / 3)}"/>` +
    `<path class="wave3" d="${wave((4 * Math.PI) / 3)}"/>` +
    t(124, 26, 'R', 'strong') + t(244, 26, 'Y', 'strong') + t(364, 26, 'B', 'strong') +
    `<path class="w" d="M130 192 V200 H250 V192"/>` + t(160, 216, '120° apart', 'small');
} else if (name === 'power-triangle') {
  vb = '0 0 380 230';
  body =
    `<path class="w" d="M30 190 H250 V50 Z"/>` +
    t(40, 214, 'P = VI cos φ (W), real') +
    t(258, 118, 'Q = VI sin φ') + t(258, 138, '(VAR), reactive', 'small') +
    t(64, 104, 'S = VI (VA)') + t(70, 124, 'apparent', 'small') +
    `<path class="w" d="M80 190 A50 50 0 0 0 74 166"/>` + t(88, 180, 'φ', 'strong') +
    `<path class="w" d="M236 190 V176 H250"/>`;
} else if (name === 'pn-junction') {
  vb = '0 0 560 250';
  const holes = [];
  for (const yy of [72, 102, 132]) for (const xx of [62, 102, 142, 182]) holes.push(`<circle class="hole" cx="${xx}" cy="${yy}" r="6"/>`);
  const elec = [];
  for (const yy of [72, 102, 132]) for (const xx of [378, 418, 458, 498]) elec.push(`<circle class="dot" cx="${xx}" cy="${yy}" r="5"/>`);
  const ions = [72, 102, 132].map((yy) => t(236, yy + 5, '−', 'strong') + t(258, yy + 5, '−', 'strong') + t(294, yy + 5, '+', 'strong') + t(316, yy + 5, '+', 'strong')).join('');
  body =
    `<rect class="preg" x="40" y="45" width="240" height="115"/>` +
    `<rect class="nreg" x="280" y="45" width="240" height="115"/>` +
    `<rect class="dep" x="226" y="45" width="108" height="115"/>` +
    holes.join('') + elec.join('') + ions +
    arrow(320, 178, 240, 178) + t(236, 198, 'built-in field', 'small') +
    t(60, 30, 'P-type: holes (○) in majority', 'small') +
    t(330, 30, 'N-type: free electrons (●)', 'small') +
    t(206, 226, 'depletion region: fixed ions, no free carriers', 'small') +
    t(222, 246, 'barrier ≈ 0.7 V (Si), 0.3 V (Ge)', 'small');
} else if (name === 'bjt') {
  vb = '0 0 540 250';
  body =
    // NPN
    `<path class="w" d="M40 120 H110 M146 82 V30 M146 158 V215"/>` + bjt(110, 120, true) +
    t(122, 24, 'C', 'strong') + t(34, 110, 'B', 'strong') + t(122, 232, 'E', 'strong') +
    arrow(160, 36, 160, 70) + t(176, 58, 'IC', 'small') +
    arrow(50, 132, 92, 132) + t(52, 152, 'IB', 'small') +
    arrow(160, 170, 160, 206) + t(176, 194, 'IE = IB + IC', 'small') +
    t(60, 248, 'NPN — arrow points out', 'small') +
    // PNP
    `<path class="w" d="M310 120 H380 M416 82 V30 M416 158 V215"/>` + bjt(380, 120, false) +
    t(392, 24, 'E', 'strong') + t(304, 110, 'B', 'strong') + t(392, 232, 'C', 'strong') +
    arrow(430, 36, 430, 70) + t(446, 58, 'IE', 'small') +
    arrow(362, 132, 320, 132) + t(322, 152, 'IB', 'small') +
    arrow(430, 170, 430, 206) + t(446, 194, 'IC', 'small') +
    t(330, 248, 'PNP — arrow points in', 'small');
} else if (name === 'vdb') {
  vb = '0 0 470 320';
  body =
    `<path class="w" d="M60 40 H330 M100 40 V160 M100 160 V270 M100 160 H200 M236 122 V40 M236 198 V270 M60 270 H330 M236 122 V110 H330"/>` +
    box(100, 95, 90) + box(100, 215, 90) + box(236, 75, 90) + box(236, 235, 90) +
    bjt(200, 160, true) +
    `<circle class="dot" cx="100" cy="160" r="4"/><circle class="dot" cx="236" cy="110" r="4"/>` +
    term(330, 110, 'Vout') +
    t(60, 30, 'VCC = 12 V', 'strong') +
    t(64, 100, 'R1') + t(64, 220, 'R2') + t(250, 80, 'RC') + t(250, 240, 'RE') +
    t(140, 152, 'VB', 'small') + t(250, 205, 'VE', 'small') +
    gnd(200, 270) + t(60, 310, 'Voltage-divider bias: R1–R2 fix VB; RE stabilises IC', 'small');
} else if (name === 'opamp') {
  vb = '0 0 680 280';
  body =
    // inverting
    `<path class="w" d="M20 105 H40 M96 105 H120 M110 105 V45 H240 V130 M210 130 H260 M120 155 H100 V180"/>` +
    box(68, 105) + box(175, 45) + opamp(120, 130) + gnd(100, 180) +
    `<circle class="dot" cx="110" cy="105" r="4"/>` +
    term(20, 105, '') + t(6, 90, 'Vin', 'small') + term(260, 130, 'Vout') +
    t(56, 90, 'Rin') + t(165, 30, 'Rf') +
    t(30, 250, 'Inverting: Av = −Rf / Rin', 'small') +
    // non-inverting
    `<path class="w" d="M380 155 H470 M470 105 H440 V40 H590 V130 M560 130 H610 M440 105 H380"/>` +
    box(515, 40) + box(410, 105) + opamp(470, 130) + gnd(380, 105) +
    `<circle class="dot" cx="440" cy="105" r="4"/>` +
    term(380, 155, '') + t(364, 182, 'Vin', 'small') + term(610, 130, 'Vout') +
    t(505, 26, 'Rf') + t(400, 90, 'R1') +
    t(380, 250, 'Non-inverting: Av = 1 + Rf / R1', 'small');
}
---

<svg class:list={['circuit', name]} viewBox={vb} role="img" aria-labelledby={`${id}-t`} xmlns="http://www.w3.org/2000/svg">
  <title id={`${id}-t`}>{label}</title>
  <defs>
    <marker id={`${id}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="ah"></path>
    </marker>
    <marker id={`${id}-ae`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="ahe"></path>
    </marker>
    <marker id={`${id}-aw`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="ahw"></path>
    </marker>
  </defs>
  <g set:html={body} />
</svg>

<style>
  .circuit {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin-inline: auto;
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font);
  }
  .circuit :global(.w) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .circuit :global(.thick) {
    stroke-width: 5;
  }
  .circuit :global(.r) {
    fill: var(--sl-color-gray-6);
    stroke: currentColor;
    stroke-width: 2.5;
  }
  .circuit :global(.gap) {
    fill: var(--sl-color-gray-6);
  }
  .circuit :global(.dot) {
    fill: currentColor;
  }
  .circuit :global(text) {
    fill: currentColor;
    font-size: 16px;
  }
  .circuit :global(text.small) {
    font-size: 14px;
    fill: var(--sl-color-gray-2);
  }
  .circuit :global(.wave),
  .circuit :global(.wave2),
  .circuit :global(.wave3) {
    fill: none;
    stroke-width: 3;
  }
  .circuit :global(.wave) {
    stroke: var(--qe-pipe-build);
  }
  .circuit :global(.wave2) {
    stroke: var(--qe-pipe-emit);
  }
  .circuit :global(.wave3) {
    stroke: var(--qe-warn);
  }
  .circuit :global(.axisd) {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .circuit :global(.rms) {
    stroke: var(--qe-pipe-emit);
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }
  .circuit :global(.field) {
    fill: none;
    stroke: var(--qe-pipe-emit);
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }
  .circuit :global(text.big) {
    font-size: 40px;
    font-weight: 700;
  }
  .circuit :global(.term) {
    fill: var(--sl-color-gray-6);
    stroke: currentColor;
    stroke-width: 2.5;
  }
  .circuit :global(text.strong) {
    font-weight: 700;
  }
  .circuit :global(.i) {
    stroke: var(--qe-pipe-build);
