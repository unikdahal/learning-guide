---
// Maximum power transfer lab: a Thevenin source (Vth = 12 V, Rth adjustable) feeding a load RL.
// Plots load power and efficiency against RL; the power peak sits exactly at RL = Rth, where efficiency is 50%.
---

<qe-mpt class="qe-lab qe-mpt not-content">
  <section class="qe-lab-part">
    <p class="qe-lab-h">Maximum power transfer lab — Vth = 12 V</p>
    <div class="ctl">
      <label>Source resistance Rth <output data-ro>4 Ω</output>
        <input type="range" min="1" max="10" step="1" value="4" data-rth aria-label="Thevenin resistance in ohms" />
      </label>
      <label>Load resistance RL <output data-lo>2 Ω</output>
        <input type="range" min="0.5" max="30" step="0.5" value="2" data-rl aria-label="Load resistance in ohms" />
      </label>
    </div>
    <svg viewBox="0 0 340 214" role="img" aria-label="Graph of load power (solid) and efficiency (dashed) against load resistance from 0 to 30 ohms. Power peaks where the load equals the source resistance; efficiency keeps rising." class="plot">
      <line class="axis" x1="40" y1="170" x2="330" y2="170" />
      <line class="axis" x1="40" y1="170" x2="40" y2="14" />
      <text x="262" y="206" class="ax">RL (Ω)</text>
      <text x="44" y="12" class="ax">P (W)</text>
      <text x="38" y="186" class="tick">0</text>
      <text x="314" y="186" class="tick">30</text>
      <text x="4" y="22" class="tick" data-pmax></text>
      <line class="peak" data-peak x1="0" y1="14" x2="0" y2="170" />
      <text class="tick" data-peakt y="200"></text>
      <path class="eff" data-eff />
      <path class="pow" data-pow />
      <circle class="pt" data-pt r="6" />
    </svg>
    <p class="legend"><span class="sw pow-sw"></span>Load power <span class="sw eff-sw"></span>Efficiency (0–100%)</p>
    <dl class="out">
      <div><dt>Current I = Vth/(Rth+RL)</dt><dd data-i></dd></div>
      <div><dt>Load power I²RL</dt><dd data-p></dd></div>
      <div><dt>Efficiency RL/(Rth+RL)</dt><dd data-e></dd></div>
    </dl>
    <p class="qe-lab-note" data-note aria-live="polite"></p>
  </section>
</qe-mpt>

<script>
  class QeMpt extends HTMLElement {
    connectedCallback() {
      const $ = (s: string) => this.querySelector(s) as HTMLElement;
      const rth = $('[data-rth]') as HTMLInputElement;
      const rl = $('[data-rl]') as HTMLInputElement;
      const V = 12;
      const f = (x: number, d = 2) => (Number.isInteger(x) ? String(x) : x.toFixed(d));
      const update = () => {
        const Rth = +rth.value;
        const RL = +rl.value;
        ($('[data-ro]') as HTMLOutputElement).value = `${Rth} Ω`;
        ($('[data-lo]') as HTMLOutputElement).value = `${RL} Ω`;
        const Pmax = (V * V) / (4 * Rth);
        const top = Pmax * 1.15;
        const X = (r: number) => 40 + (r / 30) * 290;
        const Yp = (p: number) => 170 - (p / top) * 156;
        const Ye = (e: number) => 170 - e * 156;
        let dp = '', de = '';
        for (let k = 0; k <= 120; k++) {
          const r = (k / 120) * 30;
          const p = (V * V * r) / (Rth + r) ** 2;
          const e = r / (Rth + r);
          dp += `${k ? 'L' : 'M'}${X(r).toFixed(1)} ${Yp(p).toFixed(1)}`;
          de += `${k ? 'L' : 'M'}${X(r).toFixed(1)} ${Ye(e).toFixed(1)}`;
        }
        $('[data-pow]').setAttribute('d', dp);
        $('[data-eff]').setAttribute('d', de);
        const peak = $('[data-peak]');
        peak.setAttribute('x1', String(X(Rth)));
        peak.setAttribute('x2', String(X(Rth)));
        const pt = $('[data-pt]');
        const I = V / (Rth + RL);
        const P = I * I * RL;
        const eta = RL / (Rth + RL);
        pt.setAttribute('cx', String(X(RL)));
        pt.setAttribute('cy', String(Yp(P)));
        $('[data-pmax]').textContent = f(Pmax, 1);
        const pk = $('[data-peakt]');
        pk.setAttribute('x', String(X(Rth) - 18));
        pk.textContent = `RL = Rth`;
        $('[data-i]').textContent = `${f(I)} A`;
        $('[data-p]').textContent = `${f(P)} W`;
        $('[data-e]').textContent = `${Math.round(eta * 100)}%`;
        let note: string;
        if (Math.abs(RL - Rth) < 0.01)
          note = `Matched: RL = Rth = ${Rth} Ω. The load gets the maximum possible, Vth²/(4Rth) = ${f(Pmax)} W — but efficiency is only 50%: the source's own resistance wastes as much as the load uses.`;
        else if (RL < Rth)
          note = `RL is smaller than Rth: lots of current, but most of the power is lost inside the source. Load gets ${f(P)} W of a possible ${f(Pmax)} W.`;
        else
          note = `RL is bigger than Rth: efficiency is high (${Math.round(eta * 100)}%) but the current is small, so the load gets ${f(P)} W of a possible ${f(Pmax)} W. Power grids work here — efficiency matters more than maximum power.`;
        $('[data-note]').textContent = note;
      };
      rth.addEventListener('input', update);
      rl.addEventListener('input', update);
      update();
    }
  }
  customElements.define('qe-mpt', QeMpt);
</script>

<style>
  .ctl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.8rem 1.2rem;
    margin-bottom: 0.8rem;
  }
  .ctl label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
  }
  .ctl output {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-white);
    margin-left: 0.4rem;
  }
  .ctl input {
    width: 100%;
    accent-color: var(--sl-color-accent);
  }
  .plot {
    width: 100%;
    max-width: 560px;
    height: auto;
    display: block;
    margin-inline: auto;
  }
  .axis {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .ax {
    fill: var(--sl-color-gray-1);
    font-size: 12px;
    font-weight: 600;
  }
  .tick {
    fill: var(--sl-color-gray-3);
    font-size: 11px;
  }
  .pow {
    fill: none;
    stroke: var(--qe-pipe-build);
    stroke-width: 3;
  }
  .eff {
    fill: none;
    stroke: var(--qe-pipe-emit);
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }
  .peak {
    stroke: var(--sl-color-gray-4);
    stroke-dasharray: 3 3;
  }
  .pt {
    fill: var(--qe-pipe-build);
    stroke: var(--sl-color-gray-6);
    stroke-width: 2;
  }
  .legend {
    margin: 0.3rem 0 0;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    text-align: center;
  }
  .sw {
    display: inline-block;
    width: 1.4rem;
    height: 0;
    margin: 0 0.35rem 0.25rem 0.9rem;
    vertical-align: middle;
  }
  .pow-sw {
    border-top: 3px solid var(--qe-pipe-build);
  }
  .eff-sw {
    border-top: 2px dashed var(--qe-pipe-emit);
  }
  .out {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.6rem 1.2rem;
    margin: 0.9rem 0 0;
  }
  .out dt {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .out dd {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
</style>
