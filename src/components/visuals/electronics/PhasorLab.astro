---
// AC load lab: choose R, L, C, R+L or R+C on a 10 V-peak source and drag the frequency.
// Shows voltage and current waves over two cycles, the phasor diagram, reactance, impedance and phase angle.
// Fixed parts: R = 100 Ω, L = 0.3 H, C = 30 µF (at 50 Hz, XL ≈ 94 Ω and XC ≈ 106 Ω).
---

<qe-phasor class="qe-lab qe-phasor not-content">
  <section class="qe-lab-part">
    <p class="qe-lab-h">AC load lab — what does each part do to the current?</p>
    <div class="qe-lab-chips prose" role="group" aria-label="Load">
      <button type="button" data-load="R" aria-pressed="true">R only</button>
      <button type="button" data-load="L" aria-pressed="false">L only</button>
      <button type="button" data-load="C" aria-pressed="false">C only</button>
      <button type="button" data-load="RL" aria-pressed="false">R + L</button>
      <button type="button" data-load="RC" aria-pressed="false">R + C</button>
    </div>
    <div class="ctl">
      <label>Frequency f <output data-fo>50 Hz</output>
        <input type="range" min="10" max="200" step="5" value="50" data-f aria-label="Frequency in hertz" />
      </label>
    </div>
    <div class="grid">
      <svg viewBox="0 0 300 160" role="img" aria-label="Voltage wave (solid) and current wave (dashed) over two cycles; the gap between their peaks is the phase angle." class="waves">
        <line class="axis" x1="10" y1="80" x2="295" y2="80" />
        <path class="v" data-v />
        <path class="i" data-i />
        <text x="12" y="16" class="tick">v solid · i dashed (scaled)</text>
      </svg>
      <svg viewBox="-80 -80 160 160" role="img" aria-label="Phasor diagram: voltage arrow along the horizontal axis, current arrow rotated by the phase angle." class="phasor">
        <defs>
          <marker id="ph-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="hv"></path></marker>
          <marker id="ph-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="hi"></path></marker>
        </defs>
        <circle r="64" class="ring" />
        <line class="v" x1="0" y1="0" x2="62" y2="0" marker-end="url(#ph-a)" />
        <line class="i" data-ph x1="0" y1="0" x2="40" y2="0" marker-end="url(#ph-b)" />
        <text x="44" y="-6" class="tick">V</text>
        <text class="tick" data-pht>I</text>
      </svg>
    </div>
    <dl class="out">
      <div><dt>Reactance</dt><dd data-x></dd></div>
      <div><dt>Impedance |Z|</dt><dd data-z></dd></div>
      <div><dt>Phase of I vs V</dt><dd data-phi></dd></div>
      <div><dt>Power factor cos φ</dt><dd data-pf></dd></div>
    </dl>
    <p class="qe-lab-note" data-note aria-live="polite"></p>
  </section>
</qe-phasor>

<script>
  class QePhasor extends HTMLElement {
    load = 'R';
    connectedCallback() {
      const $ = (s: string) => this.querySelector(s) as HTMLElement;
      const fIn = $('[data-f]') as HTMLInputElement;
      const R = 100, L = 0.3, C = 30e-6;
      const deg = (r: number) => (r * 180) / Math.PI;
      const update = () => {
        const f = +fIn.value;
        ($('[data-fo]') as HTMLOutputElement).value = `${f} Hz`;
        const XL = 2 * Math.PI * f * L;
        const XC = 1 / (2 * Math.PI * f * C);
        let res = 0, react = 0; // react > 0 inductive, < 0 capacitive
        if (this.load.includes('R')) res = R;
        if (this.load.includes('L')) react = XL;
        if (this.load.includes('C')) react = -XC;
        const Z = Math.hypot(res, react);
        const phi = Math.atan2(react, res); // voltage leads current by phi
        // waves: v = sin(wt), i = (scaled) sin(wt - phi)
        const W = 285, x0 = 10;
        const scaleI = Math.min(1, 100 / Z) * 0.9 + 0.1;
        let dv = '', di = '';
        for (let k = 0; k <= 200; k++) {
          const th = (k / 200) * 4 * Math.PI;
          const x = x0 + (k / 200) * W;
          dv += `${k ? 'L' : 'M'}${x.toFixed(1)} ${(80 - 60 * Math.sin(th)).toFixed(1)}`;
          di += `${k ? 'L' : 'M'}${x.toFixed(1)} ${(80 - 60 * scaleI * Math.sin(th - phi)).toFixed(1)}`;
        }
        $('[data-v]').setAttribute('d', dv);
        $('[data-i]').setAttribute('d', di);
        // phasor: current at angle -phi (SVG y is down, so +phi lag means draw below the axis)
        const len = 22 + 38 * scaleI;
        const px = len * Math.cos(-phi), py = -len * Math.sin(-phi);
        const ph = $('[data-ph]');
        ph.setAttribute('x2', px.toFixed(1));
        ph.setAttribute('y2', py.toFixed(1));
        const pt = $('[data-pht]');
        pt.setAttribute('x', (px * 1.15 - 4).toFixed(1));
        pt.setAttribute('y', (py * 1.15 + 4).toFixed(1));
        const xs = this.load.includes('L') ? `XL = ${XL.toFixed(0)} Ω` : this.load.includes('C') ? `XC = ${XC.toFixed(0)} Ω` : '0 Ω';
        $('[data-x]').textContent = xs;
        $('[data-z]').textContent = `${Z.toFixed(0)} Ω`;
        const d = deg(phi);
        $('[data-phi]').textContent = Math.abs(d) < 0.5 ? 'in phase' : d > 0 ? `lags ${d.toFixed(0)}°` : `leads ${(-d).toFixed(0)}°`;
        $('[data-pf]').textContent = `${Math.cos(phi).toFixed(2)}${Math.abs(d) < 0.5 ? '' : d > 0 ? ' lagging' : ' leading'}`;
        const notes: Record<string, string> = {
          R: 'A resistor doesn’t care about frequency: current rises and falls exactly with voltage (in phase), power factor 1.',
          L: `An inductor resists change, so current lags voltage by 90°. XL = 2πfL = ${XL.toFixed(0)} Ω — drag f up and XL grows: inductors block high frequencies.`,
          C: `A capacitor must charge before its voltage rises, so current leads by 90°. XC = 1/(2πfC) = ${XC.toFixed(0)} Ω — drag f up and XC shrinks: capacitors pass high frequencies.`,
          RL: `R and XL combine at right angles: |Z| = √(R² + XL²) = ${Z.toFixed(0)} Ω, and current lags by ${d.toFixed(0)}° — somewhere between 0° (pure R) and 90° (pure L).`,
          RC: `|Z| = √(R² + XC²) = ${Z.toFixed(0)} Ω, and current leads by ${(-d).toFixed(0)}°. Raise f: XC falls, so the circuit looks more resistive and the angle shrinks.`,
        };
        $('[data-note]').textContent = notes[this.load];
      };
      this.querySelectorAll<HTMLButtonElement>('[data-load]').forEach((b) =>
        b.addEventListener('click', () => {
          this.load = b.dataset.load!;
          this.querySelectorAll('[data-load]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          update();
        }),
      );
      fIn.addEventListener('input', update);
      update();
    }
  }
  customElements.define('qe-phasor', QePhasor);
</script>

<style>
  .ctl {
    margin: 0.9rem 0;
  }
  .ctl label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
  }
  .ctl output {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-white);
    margin-left: 0.4rem;
  }
  .ctl input {
    width: 100%;
    accent-color: var(--sl-color-accent);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }
  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .phasor {
      max-width: 12rem;
      margin-inline: auto;
    }
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .axis,
  .ring {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
    fill: none;
  }
  .v {
    fill: none;
    stroke: var(--qe-pipe-build);
    stroke-width: 2.5;
  }
  .i {
    fill: none;
    stroke: var(--qe-pipe-emit);
    stroke-width: 2.5;
    stroke-dasharray: 6 4;
  }
  .hv {
    fill: var(--qe-pipe-build);
  }
  .hi {
    fill: var(--qe-pipe-emit);
  }
  .tick {
    fill: var(--sl-color-gray-2);
    font-size: 11px;
  }
  .out {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.6rem 1.2rem;
    margin: 0.9rem 0 0;
  }
  .out dt {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .out dd {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
</style>
