{
  "name": "learning-guide",
  "description": "Query Execution, from first principles to engine internals",
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/answer-bank.mjs",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:content": "node scripts/generate.mjs --check && node scripts/answer-bank.mjs --check",
    "check": "npm run check:content && astro check",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "check:site": "python3 scripts/qa/check_site.py",
    "verify": "npm test && npm run check && npm run build && npm run check:site",
    "publish": "node scripts/publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unikdahal/learning-guide.git"
  },
  "bugs": {
    "url": "https://github.com/unikdahal/learning-guide/issues"
  },
  "homepage": "https://github.com/unikdahal/learning-guide#readme",
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^7.4.5",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
